@model project.Models.ViewModels.EmpleadoViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Gestion de Empleados";
    var Pagina = ViewBag.nroPagina ?? 1;
    var cantidadTotalDePaginas = ViewBag.cantidadTotalDePaginas ?? 1;
}
<style>
    /* Placeholder de DNI rojo y negrita cuando hay error texto: "SOLO NUMEROS"*/
    #dniInput.placeholder-error::placeholder {
        color: #dc3545 !important;
        font-weight: bold;
        opacity: 1;
    }
</style>

<div class="container-fluid text-center d-flex flex-column align-items-center justify-content-center">
    <div class="text-center mb-3 mt-3 shadow p-2 " style="min-width: 100vh;">
        <h3 class="text-white mb-2">Listado de Empleados</h3>
    </div>

    <div class="d-flex flex-column  p-2 shadow rounded" style=" min-height: 80vh; min-width: 80vw; ">
        
        <div class=" d-flex w-100 ">
            <div class="w-25 d-flex justify-content-center" >
                <a class="btn btn-dark shadow  w-75" onclick="window.location.href='/Empleado/new'"> Registrar</a>
            </div>
            <div class="w-50">
                <input type="text" id="inputBuscarEmpleado" 
                oninput="this.value = this.value.replace(/[^0-9]/g, '');" 
                maxlength="8"
                class="form-control w-100" placeholder="Buscar Empleado por DNI">
            </div>
            <!--SELECTOR TRIPLE PARA "TODOS" "ACTIVOS" "INACTIVOS"-->
            <div class=" w-25 mt-2">
                <div class="d-flex justify-content-end gap-3">
                    <div class="form-check form-check-inline">
                        <input class="form-check-input " type="radio" name="estadoEmpleado" id="estadoTodos" value="todos" checked>
                        <label class="form-check-label " style="color:white; for="estadoTodos">Todos</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="estadoEmpleado" id="estadoActivos" value="1">
                        <label class="form-check-label " style="color:white; for="estadoActivos">Activos</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="estadoEmpleado" id="estadoInactivos" value="0">
                        <label class="form-check-label  " style="color:white;" for="estadoInactivos">Inactivos</label>
                    </div>
                </div>
            </div>
        </div>
    <div id="tablaEmpleados" class="table-responsive p-2" style="min-height: 600px;">
        <table class="table table-dark table-stripped" style="overflow-x: auto;">
            <thead>
                <tr class="text-center">
                    <th style="width: 20%;">Nombre</th>
                    <th style="width: 10%;">DNI</th>
                    <th style="width: 10%;">Teléfono</th>
                    <th style="width: 10%;">Dirección</th>
                    <th style="width: 15%;">Email</th>
                    <th style="width: 10%;">Estado</th>
                    <th style="width: 10%;">Rol</th>
                    <th style="width: 10%;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Empleado empleado in Model.Empleados)
                {
                    <tr class="text-center">
                        <td>@empleado.Nombre @empleado.Apellido</td>
                        
                        <td>@empleado.Dni</td>
                        <td>@empleado.Telefono</td>
                        <td>@empleado.Direccion</td>
                        <td>@empleado.Email</td>
                        <td>
                            @if (@empleado.Estado)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td>
                            @if(empleado.Usuario!.Rol.IdRol == 1){
                                <span class="badge bg-success">Administrador</span>
                            }
                            @if(empleado.Usuario!.Rol.IdRol == 2){
                                <span class="badge bg-info">Empleado</span>
                            }
                        </td>
                        <td>
                            @if (!empleado.Estado)
                            {
                                <button class="btn btn-sm btn-outline-success me-1" onclick="altaEmpleado(@empleado.IdEmpleado)" title="Dar de alta">
                                    <i class="bi bi-person-check-fill"></i>
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-danger me-1" onclick="bajaEmpleado(@empleado.IdEmpleado)" title="Dar de baja">
                                    <i class="bi bi-person-x-fill"></i>
                                </button>
                            }
                            @if(empleado.Usuario.idUsuario != 0){
                                <button class="btn btn-sm btn-outline-info me-1" onclick="resetearContraseniaEmpleado(@empleado.IdUsuario)" title="Resetear Contraseña">
                                    <i class="bi bi-key"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-warning me-1" onclick="cambiarRolEmpleado(@empleado.IdUsuario, @empleado.Usuario!.Rol!.IdRol)" title="Cambiar Rol">
                                    <i class="bi bi-gear"></i>
                                </button>
                            }else{
                                <button class="btn btn-sm btn-outline-info me-1" disabled onclick="resetearContraseniaEmpleado(@empleado.IdUsuario)" title="Resetear Contraseña">
                                    <i class="bi bi-key"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-warning me-1" disabled onclick="cambiarRolEmpleado(@empleado.IdUsuario, @empleado.Usuario!.Rol!.IdRol)" title="Cambiar Rol">
                                    <i class="bi bi-gear"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div id="paginacion" class="col d-flex w-100 justify-content-between">
            <nav aria-label="Page navigation">
                <ul class="pagination">
                    @if (Pagina > 1)
                    {
                        <li class="page-item" onclick="cambiarPagina(@Pagina - 1)">
                            <a class="page-link" id="btnAnterior"  aria-label="Anterior">
                                <i class="bi bi-chevron-double-left text-black"></i>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled" >
                            <span class="page-link"><i class="bi bi-chevron-double-left text-black"></i></span>
                        </li>
                    }
                    @for(int i = 1; i <= cantidadTotalDePaginas; i++)
                    {
                        <li class="page-item @(i == Pagina ? "active" : "")" onclick="cambiarPagina(@i)">
                            <a class="page-link " >@i</a>
                        </li>
                    }
                    @if (Pagina < cantidadTotalDePaginas)
                    {
                        <li class="page-item">
                            <a class="page-link" id="btnSiguiente" onclick="cambiarPagina(@Pagina + 1)" aria-label="Siguiente">
                                <i class="bi bi-chevron-double-right text-black"></i>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link">
                                <i class=" bi bi-chevron-double-right text-black">

                                </i>
                            </span>
                        </li>
                    }
                </ul>
            </nav>

        </div>
        <button class="btn btn-danger   align-self-end " onclick="window.location.href='/'">Volver</button>

</div>

<script>
    let pagina = @Pagina;

    function cambiarPagina(nroPagina){
        pagina = nroPagina;
        actualizarContenido();
    }
    function verificarFiltrosActivos(parametros){
        const circulitos = document.getElementsByName("estadoEmpleado");
        for(let i = 0; i < circulitos.length; i++){
            if(circulitos[i].checked && circulitos[i].value != "todos"){
                parametros.append("estado", circulitos[i].value);
            }
        }
    }
    async function resetearContraseniaEmpleado(idUsuario){
        try{
            const respuesta = await Swal.fire({
                title: 'Confirmar reseteo de contraseña',
                icon: 'warning',
                input: 'password',
                inputLabel: 'Escriba "CONFIRMAR" para verificar la acción:',
                inputPlaceholder: 'Escriba CONFIRMAR...',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Resetear Contraseña',
                cancelButtonText: 'Cancelar',
                inputValidator: (value) => {
                    if (!value) {
                        return 'Este campo es obligatorio';
                    }
                    if (value.toUpperCase() !== 'CONFIRMAR') {
                        return 'Debe escribir exactamente "CONFIRMAR"';
                    }
                }
            });

            if(respuesta.isConfirmed){
                const response = await fetch(`/Usuario/resetearContrasena?idUsuario=${idUsuario}`);
                if(!response.ok){
                    throw new Error(await response.text());
                }
                actualizarContenido();
                Swal.fire({
                    title: 'Éxito',
                    text: 'Contraseña reseteada correctamente',
                    icon: 'success',
                    confirmButtonText: 'Aceptar'
                });
            }
        }catch(error){
            swal.fire({
                title: 'Error',
                text: error,
                icon: 'error',
                confirmButtonText: 'Aceptar'
            });
        }
    }
    async function cambiarRolEmpleado(idUsuario, rolActual) {
        try {
            const result = await Swal.fire({
                title: '¿Desea cambiar el rol del empleado?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Si',
                cancelButtonText: 'No'
            });

            if (result.isConfirmed) {
                const response = await fetch(`/Usuario/cambiarRol?idUsuario=${idUsuario}&idRolActual=${rolActual}`);
                
                if (!response.ok) {
                    throw new Error(await response.text());
                }
                
                actualizarContenido();
                Swal.fire({
                    title: 'Éxito',
                    text: 'Rol cambiado correctamente',
                    icon: 'success',
                    confirmButtonText: 'Aceptar'
                });
            }
        } catch (error) {
            console.error("Error:", error);
            Swal.fire({
                title: 'Error',
                text: error,
                icon: 'error',
                confirmButtonText: 'Aceptar'
            });
        }
    }
    function verificarFiltroDni(parametros){
        const inputBusquedaEmpleado = document.getElementById("inputBuscarEmpleado").value;
        if(inputBusquedaEmpleado.trim() != ""){
            parametros.append("dni", inputBusquedaEmpleado);
        }
    }
    async function actualizarContenido(){
        
        let url = "/Empleado?";
        const parametros = new URLSearchParams();
        parametros.append("nroPagina", pagina);
        verificarFiltrosActivos(parametros);
        verificarFiltroDni(parametros);
        url += parametros.toString();
        try{
            const response = await fetch(url);
            if(!response.ok){
                console.error("Error al obtener los empleados");
                return;
            }
            const data =  await response.text();
            const dom = new DOMParser().parseFromString(data, 'text/html');
            const fragmentoTabla = obtenerFragmentoHTML('tablaEmpleados', dom);
            const fragmentoPaginacion = obtenerFragmentoHTML('paginacion', dom);
            document.getElementById("tablaEmpleados").replaceWith(fragmentoTabla);
            document.getElementById("paginacion").replaceWith(fragmentoPaginacion);
        }catch(error){
            console.error(error);
            return;
        }
         
    }
    function obtenerFragmentoHTML(id, html){
        return html.getElementById(id);
    }
    document.getElementsByName("estadoEmpleado").forEach(circulo => {
        circulo.addEventListener("change", actualizarContenido);
    })
    async function bajaEmpleado(idEmpleado){
        const response = await fetch('/Empleado/Baja?idEmpleado=' + idEmpleado);
        if(response.ok){
            actualizarContenido();
            return
        }
        console.error("Error al dar de baja el empleado");
    }
    async function altaEmpleado(idEmpleado){
        const response = await fetch('/Empleado/Alta?idEmpleado=' + idEmpleado);
        if(response.ok){
            actualizarContenido();
            return
        }
        console.error("Error al dar de alta el empleado");
    }
    document.getElementById("inputBuscarEmpleado").addEventListener("input", actualizarContenido);
</script>

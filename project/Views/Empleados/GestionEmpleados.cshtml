@model project.Models.ViewModels.EmpleadoViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Gestion de Empleados";
    var Pagina = ViewBag.nroPagina ?? 1;
    var cantidadTotalDePaginas = ViewBag.cantidadTotalDePaginas ?? 1;
}
<style>
    /* Placeholder de DNI rojo y negrita cuando hay error texto: "SOLO NUMEROS"*/
    #dniInput.placeholder-error::placeholder {
        color: #dc3545 !important;
        font-weight: bold;
        opacity: 1;
    }
</style>

<div class="container-fluid text-center d-flex flex-column align-items-center justify-content-center">
    <div class="text-center mb-3 mt-3 shadow p-2 " style="min-width: 100vh;">
        <h3 class="text-white mb-2 ms-3">Listado de Empleados</h3>
    </div>

    <div class="d-flex flex-column p-2 shadow rounded" style=" min-height: 80vh; min-width: 80vw; ">
        
        <div class="row ">
            <div class="w-25" style="margin-left: -80px;">
                <a class="btn btn-dark shadow  w-50" onclick="window.location.href='/Empleado/new'"> Registrar</a>
            </div>
            <!--SELECTOR TRIPLE PARA "TODOS" "ACTIVOS" "INACTIVOS"-->
            <div class="col w-25 mt-2">
                <div class="d-flex justify-content-end gap-3">
                    <div class="form-check form-check-inline">
                        <input class="form-check-input " type="radio" name="estadoEmpleado" id="estadoTodos" value="todos" checked>
                        <label class="form-check-label " style="color:white; for="estadoTodos">Todos</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="estadoEmpleado" id="estadoActivos" value="1">
                        <label class="form-check-label " style="color:white; for="estadoActivos">Activos</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="estadoEmpleado" id="estadoInactivos" value="0">
                        <label class="form-check-label  " style="color:white;" for="estadoInactivos">Inactivos</label>
                    </div>
                </div>
            </div>
        </div>
    <div id="tablaEmpleados" class="table-responsive p-2" style="min-height: 600px;">
        <table class="table table-dark table-stripped" style="overflow-x: auto;">
            <thead>
                <tr class="text-center">
                    <th style="width: 20%;">Nombre</th>
                    <th style="width: 10%;">DNI</th>
                    <th style="width: 10%;">Teléfono</th>
                    <th style="width: 10%;">Dirección</th>
                    <th style="width: 15%;">Email</th>
                    <th style="width: 10%;">Estado</th>
                    <th style="width: 10%;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Empleado empleado in Model.Empleados)
                {
                    <tr class="text-center">
                        <td>@empleado.Nombre @empleado.Apellido</td>
                        
                        <td>@empleado.Dni</td>
                        <td>@empleado.Telefono</td>
                        <td>@empleado.Direccion</td>
                        <td>@empleado.Email</td>
                        <td>
                            @if (@empleado.Estado)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td>
                            <button class="btn btn-sm  me-1" onclick="altaEmpleado(@empleado.IdEmpleado)"></button>
                            @if (!empleado.Estado)
                            {
                                <button class="btn btn-sm btn-outline-success me-1" onclick="altaEmpleado(@empleado.IdEmpleado)" title="Dar de alta">
                                    <i class="bi bi-person-check-fill"></i>
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-danger me-1" onclick="bajaEmpleado(@empleado.IdEmpleado)" title="Dar de baja">
                                    <i class="bi bi-person-x-fill"></i>
                                </button>
                            }

                            <button class="btn btn-sm btn-warning" onclick="verContratosPropietario(@empleado.IdEmpleado)"><i class="fa-solid fa-key"></i></button>

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div id="paginacion" class="col d-flex w-100 justify-content-between">
            <nav aria-label="Page navigation">
                <ul class="pagination">
                    @if (Pagina > 1)
                    {
                        <li class="page-item" onclick="cambiarPagina(@Pagina - 1)">
                            <a class="page-link" id="btnAnterior"  aria-label="Anterior">
                                <i class="bi bi-chevron-double-left"></i>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled" >
                            <span class="page-link"><i class="bi bi-chevron-double-left"></i></span>
                        </li>
                    }
                    @for(int i = 1; i <= cantidadTotalDePaginas; i++)
                    {
                        <li class="page-item @(i == Pagina ? "active" : "")" onclick="cambiarPagina(@i)">
                            <a class="page-link" >@i</a>
                        </li>
                    }
                    @if (Pagina < cantidadTotalDePaginas)
                    {
                        <li class="page-item">
                            <a class="page-link" id="btnSiguiente" onclick="cambiarPagina(@Pagina + 1)" aria-label="Siguiente">
                                <i class="bi bi-chevron-double-right"></i>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link">
                                <i class="bi bi-chevron-double-right">

                                </i>
                            </span>
                        </li>
                    }
                </ul>
            </nav>
        </div>
</div>

<script>
    let pagina = @Pagina;

    function cambiarPagina(nroPagina){
        pagina = nroPagina;
        actualizarContenido();
    }
    function verificarFiltrosActivos(parametros){
        const circulitos = document.getElementsByName("estadoEmpleado");
        for(let i = 0; i < circulitos.length; i++){
            if(circulitos[i].checked && circulitos[i].value != "todos"){
                parametros.append("estado", circulitos[i].value);
            }
        }
    }
    async function actualizarContenido(){
        
        let url = "/Empleado?";
        
        const parametros = new URLSearchParams();
        parametros.append("nroPagina", pagina);
        verificarFiltrosActivos(parametros);
        url += parametros.toString();
        try{
            const response = await fetch(url);
            if(!response.ok){
                console.error("Error al obtener los empleados");
                return;
            }
            const data =  await response.text();
            const dom = new DOMParser().parseFromString(data, 'text/html');
            const fragmentoTabla = obtenerFragmentoHTML('tablaEmpleados', dom);
            const fragmentoPaginacion = obtenerFragmentoHTML('paginacion', dom);
            document.getElementById("tablaEmpleados").replaceWith(fragmentoTabla);
            document.getElementById("paginacion").replaceWith(fragmentoPaginacion);
        }catch(error){
            console.error(error);
            return;
        }
         
    }
    function obtenerFragmentoHTML(id, html){
        return html.getElementById(id);
    }
    document.getElementsByName("estadoEmpleado").forEach(circulo => {
        circulo.addEventListener("change", actualizarContenido);
    })
    async function bajaEmpleado(idEmpleado){
        const response = await fetch('/Empleado/Baja?idEmpleado=' + idEmpleado);
        if(response.ok){
            actualizarContenido();
            return
        }
        console.error("Error al dar de baja el empleado");
    }
    async function altaEmpleado(idEmpleado){
        const response = await fetch('/Empleado/Alta?idEmpleado=' + idEmpleado);
        if(response.ok){
            actualizarContenido();
            return
        }
        console.error("Error al dar de alta el empleado");
    }
</script>


@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Unauthorized";
}
<div class="container container-fluid d-flex justify-content-center">
    <div class="card p-1 m-2" style="width: 41rem; border-radius: 10px; background-color: rgba(0, 0, 0, 0.4);">
        <img  class="card-img-top" style="border-radius: 10px" src="~/images/Paso.png"/>
        <div class="card-body">
            <p class=" text-center card-text text-danger fw-bold fs-1" style="border: 1px solid red; border-radius: 10px">Acceso no autorizado</p>
            <p class=" text-center card-text text-danger fw-bold fs-5">No cuentas con permisos para acceder a esta página y/o recurso</p>
            
    </div>
        
    </div>
</div>
<div class="container container-fluid d-flex justify-content-center align-items-start vh-100 mt-5">
    <div class="card bg-light" style="border-radius: 20px;">
        <div class="card-header text-center p-4 fs-4">
            <h1>Registrar Usuario</h1>
        </div>
        <div class="card-body p-3 m-3">
            <form action="" method="post" id="registroForm">
                <div class="form-group mb-3">
                    <label for="Dni">Dni</label>
                    <input type="text" name="Dni"
                    placeholder="Ingrese su Dni" id="InputDni"
                    maxlength="8"
                    oninput="this.value = this.value.replace(/[^0-9.]/g, '').replace(/(\..*)\./g, '$1');" 
                    class="form-control" />
                </div>
                <div class="form-group mb-3">
                    <label for="gmail">Gmail</label>
                    <input name="gmail" 
                    id="InputGmail" 
                    class="form-control"  
                    placeholder="Ingrese su Gmail"
                    disabled
                    required />
                </div>
                <div class="form-group mb-3">
                    <label for="contrasena">Contraseña</label>
                    <input type="password"
                    name="contrasena" 
                    id="InputContrasena" 
                    placeholder="Ingrese su Contraseña"
                    class="form-control"
                    disabled
                    required/>
                </div>
                <div class="form-group mb-3">
                    <label for="confirmarContrasena">Confirmar Contraseña</label>
                    <input type="password"
                    name="confirmarContrasena" 
                    id="InputConfirmarContrasena" 
                    class="form-control" 
                    placeholder="Confirme su Contraseña"
                    disabled
                    required/>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <a class="btn btn-link" id="linkLogin" href="/Auth/VistaLogin">¿Ya tienes una cuenta?</a>
                    <button type="submit" id="btnRegistrar" disabled class="btn btn-primary">Registrar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    
    let inputDni, inputGmail, inputContrasena, inputConfirmarContrasena, btnRegistrar, linkLogin;

    document.addEventListener('DOMContentLoaded', function() {
       
        inputDni = document.getElementById("InputDni");
        inputGmail = document.getElementById("InputGmail");
        inputContrasena = document.getElementById("InputContrasena");
        inputConfirmarContrasena = document.getElementById("InputConfirmarContrasena");
        btnRegistrar = document.getElementById("btnRegistrar");
        linkLogin = document.getElementById("linkLogin");

        
        inputDni.addEventListener("input", function() {
            if (this.value.length === 8) {
                validarEmpleadoRegistrado();
            } else {
                deshabilitarInputs();
            }
        });

       
        inputContrasena.addEventListener("input", validarFormulario);
        inputConfirmarContrasena.addEventListener("input", validarFormulario);
    });

    function limpiarInput(){
        inputDni.value = "";
        inputGmail.value = "";
        inputContrasena.value = "";
        inputConfirmarContrasena.value = "";
    }

    function deshabilitarInputs(){
        inputGmail.disabled = true;
        inputContrasena.disabled = true;
        inputConfirmarContrasena.disabled = true;
        btnRegistrar.disabled = true;
    }

    function habilitarInputs(){
        inputGmail.disabled = false;
        inputContrasena.disabled = false;
        inputConfirmarContrasena.disabled = false;
    }

    function deshabilitarYLimpiarInputs(){
        deshabilitarInputs();
        limpiarInput();
    }

    function validarFormulario() {
  
        const contrasena = inputContrasena.value;
        const confirmarContrasena = inputConfirmarContrasena.value;
        
        if (contrasena && confirmarContrasena) {
            if (contrasena === confirmarContrasena) {
                btnRegistrar.disabled = false;
                return true;
            } else {
                btnRegistrar.disabled = true;
                return false;
            }
        }
        btnRegistrar.disabled = true;
        return false;
    }

    async function validarEmpleadoRegistrado(){
        const params = new URLSearchParams();
        params.append("dni", inputDni.value);
        
        try{
            const response = await fetch("/Empleado/Validar?" + params.toString());
            if(!response.ok){
                throw new Error('Error en la respuesta del servidor');
            }
            
            const data = await response.json();
            console.log(data)
            if(data.existe){
                inputGmail.disabled = false;
                inputGmail.value = "";
                inputGmail.value = data.empleado.email || "";
                inputGmail.disabled = true;
                inputContrasena.disabled = false;
                inputConfirmarContrasena.disabled = false;
                
            } else {
                inputGmail.disabled = true;
                inputGmail.value = "";
                inputContrasena.disabled = true;
                inputConfirmarContrasena.disabled = true;
                btnRegistrar.disabled = true;
                
                Swal.fire({
                    icon: 'error',
                    title: 'Empleado no encontrado',
                    text: 'El DNI ingresado no corresponde a un empleado válido',
                });
            }
        } catch(error) {
            console.error('Error:', error);
            deshabilitarInputs();
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'Error al validar el empleado, intente nuevamente',
            });
        }
    }
</script>
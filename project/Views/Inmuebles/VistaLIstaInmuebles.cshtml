@model project.Models.ViewModels.InmuebleViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div>
    <h2 class="text-center mt-4 text-white fs-2 mt-1">Lista de Inmuebles Registrados</h2>
    <div class="table-responsive">
        <table class="table table-striped table-bordered mt-4 table-dark mb-3 ">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Uso</th>
                    <th>Tipo de Inmueble</th>
                    <th>Superficie (m²)</th>
                    <th>Cantidad de Ambientes</th>
                    <th>Coordenadas</th>
                    <th>Precio</th>
                    <th>Dirección</th>
                    <th>Propietario</th>
                    <th>Alquilado</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.inmueble != null && Model.tipo_Inmueble != null )
                {
                    foreach (var inmueble in Model.inmueble)
                    {
                        
                        <tr>
                            <td class="text-center p-3">@inmueble.IdInmueble</td>
                            <td class="text-center p-3">@inmueble.Uso</td>
                            <td class="text-center p-3">@inmueble.Tipo.nombre</td>
                            <td class="text-center p-3">@inmueble.Superficie</td>
                            <td class="text-center p-3">@inmueble.CantidadAmbientes</td>
                            <td class="text-center p-3">@inmueble.Coordenadas</td>
                            <td class="text-center p-3">$@inmueble.Precio</td>
                            <td class="text-center p-3">@inmueble.Direccion</td>
                            <td class="text-center p-3">@inmueble.Propietario!.Nombre @inmueble.Propietario.Apellido - @inmueble.Propietario.Dni</td>
                            <td class="text-center p-3">
                                @if (!inmueble.estado)
                                {
                                    <i class="bi bi-house-slash-fill text-danger fs-3" title="No disponible - Dado de baja"></i>
                                }
                                else
                                {
                                    @if (inmueble.Disponible)
                                    {
                                        <i class="bi bi-house text-secondary fs-3" title="Disponible - No alquilado"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-house-check-fill text-success fs-3" title="Alquilado"></i>
                                    }
                                }

                            </td>
                            <td class="text-center p-3">
                                @if (inmueble.estado)
                                {
                                    <i class= "bi bi-check-circle-fill text-success fs-3" title = "Activo" ></i>
                                }
                                else
                                {
                                    <i class="bi bi-x-circle-fill text-danger fs-3" title="Inactivo - Dado de baja"></i>
                                }
                            </td>
                            <td class="text-center p-3 d-flex d-inline-flex">
                                <a class="btn btn-warning p-1 m-1" href="@Url.Action("Actualizar", "Inmueble", new { idInmueble = inmueble.IdInmueble })">Actualizar</a>
                                @if (inmueble.estado)
                                {
                                    @if (inmueble.Disponible)
                                    {
                                        <a class="btn btn-danger p-1 m-1" href="@Url.Action("MarcarAlquilado", "Inmueble", new { idInmueble = inmueble.IdInmueble })">Marcar alquilado</a>
                                    }
                                    else
                                    {
                                        <a class="btn btn-success p-1 m-1" href="@Url.Action("MarcarLibre", "Inmueble", new { idInmueble = inmueble.IdInmueble })">Marcar como libre</a>
                                    }
                                }
                                @if (inmueble.Disponible && inmueble.estado || (!inmueble.Disponible && !inmueble.estado))
                                {
                                    @if (inmueble.estado)
                                    {
                                        <a class="btn btn-danger p-1 m-1" href="@Url.Action("DarBajaLogica", "Inmueble", new { idInmueble = inmueble.IdInmueble })">Dar Baja</a>
                                    }
                                    else
                                    {
                                        <a class="btn btn-success p-1 m-1" href="@Url.Action("DarAltaLogica", "Inmueble", new { idInmueble = inmueble.IdInmueble })">Dar Alta</a>
                                    }
                                }

                            </td>
                        </tr>
                    }
                }                            
                        
                
            </tbody>
        </table>

    </div>
</div>
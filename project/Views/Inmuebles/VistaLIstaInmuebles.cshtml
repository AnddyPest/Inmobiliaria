@model project.Models.ViewModels.InmuebleViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var Pagina = ViewBag.nroPagina ?? 1;
    var Disponibilidad = ViewBag.disponibilidad ?? null;
    var DniPropietarioViewBag = ViewBag.dniPropietario ?? null;
    var usoViewBag = ViewBag.uso ?? null;
    var tipoViewBag = ViewBag.tipo ?? null;
    var cantAmbientesViewBag = ViewBag.cantAmbientes ?? null;
    var precioAproxViewBag = ViewBag.precio ?? null;
    var fechaDesdeViewBag = ViewBag.fechaDesde ?? null;
    var fechaHastaViewBag = ViewBag.fechaHasta ?? null;
}
@using Newtonsoft.Json
<script>
    window.Model = {
        inmueble: @Html.Raw(JsonConvert.SerializeObject(Model.inmueble))
    };
    
</script>

<div class="container d-flex flex-column align-items-center ">
    <div class="d-flex flex-fill align-items-center w-100 shadow-lg pb-3">
        <h2 class="text-center mt-4 text-white fs-2 mt-1">Lista de Inmuebles Registrados</h2>
        <div class="d-flex  flex-column mt-3 shadow p-3">
            <div class="d-flex flex-fill w-100  me-3 mb-3 ">
                <select id="selectDisponible" class="form-select w-25 me-3">
                <option value="" disabled selected>Filtro de disponibilidad</option>
                @{
                    (bool?,string)[] disponibilidades = { (null,"Todas las disponibilidades"), (true,"Disponible"), (false,"No Disponible") };
                }
                @foreach((bool?, string) disponibilidad in disponibilidades){   
                    if(disponibilidad.Item1 == Disponibilidad){
                        <option value="@disponibilidad.Item1" selected>@disponibilidad.Item2</option>
                    }else{
                        <option value="@disponibilidad.Item1">@disponibilidad.Item2</option>}
                    }
                }
                @* @if(Disponibilidad != null){
                    <option value="@Disponibilidad" selected>@Disponibilidad</option>
                }else{
                    <option value="" selected>Todas las disponibilidades</option>
                }
                <option value="" >Todas las disponibilidades</option>
                <option value="true">Disponible</option>
                <option value="false">No Disponible</option> *@
                </select>
                @if(DniPropietarioViewBag != null){
                    <input class="form-control w-25" type="text" id="inputDniFiltro"
                        maxlength="8" placeholder="Filtro por dni"
                        oninput="this.value = this.value.replace(/[^0-9]/g, '');" value="@DniPropietarioViewBag"/>
                }else{
                    <input class="form-control w-25" type="text" id="inputDniFiltro"
                        maxlength="8" placeholder="Filtro por dni"
                        oninput="this.value = this.value.replace(/[^0-9]/g, '');" />
                }
                <select class="form-select w-25 ms-3" id="selectUso">
                    @{
                        (string clave,string valor)[] usos = { ("Todos los usos",""),("Comercial","Comercial"),("Residencial","Residencial")};
                    }
                    @foreach( (string clave,string valor) uso in usos){
                        @if(uso.valor == usoViewBag){
                            <option value="@uso.valor" selected>@uso.clave</option>
                        }else{
                            <option value="@uso.valor">@uso.clave</option>
                        }
                    }
                </select>
                <select class="form-select w-25 ms-3" id="selectTipo">
                    <option value="" disabled selected>Filtro por tipo</option>
                    <option value="">Todos los tipos</option>
                    @if(Model.tipo_Inmueble != null){
                        @foreach(Tipo_Inmueble tipo in Model.tipo_Inmueble){
                            @if(tipo.nombre == tipoViewBag){
                                <option value="@tipo.nombre.Trim()" selected>@tipo.nombre</option>
                            }else{
                                <option value="@tipo.nombre.Trim()">@tipo.nombre</option>
                            }
                        }
                    }
                    
                </select>
                
            </div>
            <div class="d-flex flex-fill w-100  ">
                <input class=" form-control w-25 " type="number" id="inputCantAmbientes"
                        maxlength="4" placeholder="Filtro Cant.ambientes" value="@cantAmbientesViewBag"
                        oninput="this.value = this.value.replace(/[^0-9]/g, '');" />
                
                
                <input class=" form-control w-25 ms-3" type="number" id="inputPrecioAproximado"
                        maxlength="9" placeholder="Filtro por precio " value="@precioAproxViewBag"
                        oninput="this.value = this.value.replace(/[^0-9]/g, '');" />
                
                <input class=" form-control w-25 ms-3 " type="date" id="inputInicioAlquiler"
                         placeholder="Inicio alquiler " value="@fechaDesdeViewBag"
                        oninput="" />
                <input class=" form-control w-25 ms-3" type="date" id="inputFinAlquiler"
                        placeholder="Fin alquiler " value="@fechaHastaViewBag"
                        oninput="" /> 
            </div>

        </div>
        <button onclick="limpiarFiltrosv2()" class="btn btn-danger m-1">Limpiar</button>
        <button onclick="aplicarFiltrosv2()" class="btn btn-primary m-1">Enviar</button>

    </div>
    
    <div class="table-container" style="min-height: 65vh;">
        <table class="table table-striped table-bordered mt-4 table-dark mb-3 " id="myTable">
            <thead class="table-dark text-center">
                <tr>
                    <th class="text-center" style="min-width: 50px; width: 3%;">ID</th>
                    <th style="min-width: 80px; width: 5%;">Uso</th>
                    <th style="min-width: 80px; width: 5%;">Tipo</th>
                    <th class="text-center" style="min-width: 50px; width: 3%;">Sup</th>
                    <th class="text-center" style="min-width: 50px; width: 3%;">Amb</th>
                    <th class="text-center" style="min-width: 80px; width: 5%;">Coord</th>
                    <th class="text-end" style="min-width: 80px; width: 5%;">Precio</th>
                    <th style="min-width: 150px; width: 10%;">Dirección</th>
                    <th style="min-width: 150px; width: 10%;">Propietario</th>
                    <th class="text-center" style="min-width: 80px; width: 5%;">DNI Prop</th>
                    <th class="text-center" style="min-width: 80px; width: 5%;">Alquilado</th>
                    <th class="text-center" style="min-width: 80px; width: 5%;">Estado</th>
                    <th class="text-center" style="min-width: 180px; width: 12%;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.inmueble != null && Model.tipo_Inmueble != null )
                {
                    foreach (var inmueble in Model.inmueble)
                    {
                        Console.WriteLine(inmueble);
                        <tr>
                            <td class="text-center ">@inmueble.IdInmueble</td>
                            <td class="text-center ">@inmueble.Uso</td>
                            <td class="text-center ">@(inmueble.Tipo != null ? inmueble.Tipo.nombre : "")</td>
                            <td class="text-center ">@inmueble.Superficie</td>
                            <td class="text-center ">@inmueble.CantidadAmbientes</td>
                            <td class="text-center ">@inmueble.Coordenadas</td>
                            <td class="text-center ">$@inmueble.Precio</td>
                            <td class="text-center ">@inmueble.Direccion</td>
                            <td class="text-center ">@inmueble.Propietario!.Nombre @inmueble.Propietario.Apellido</td>
                            <td class="text-center ">@inmueble.Propietario!.Dni</td>
                            <td class="text-center flex">
                                <input type="hidden" class="input-disponible" data-id="@inmueble.IdInmueble" value="@inmueble.Disponible.ToString().ToLower()" />
                                <input type="hidden" class="input-estado" data-id="@inmueble.IdInmueble" value="@inmueble.Estado.ToString().ToLower()" />
                                <input type="hidden" class="inputHiddenDni" data-id="@inmueble.IdInmueble" value="@inmueble.Propietario.Dni" />
                                @if (!inmueble.Estado)
                                {
                                    <i class="bi bi-house-slash-fill text-danger fs-4" title="No disponible - Dado de baja"></i>
                                }
                                else
                                {
                                    @if (inmueble.Disponible)
                                    {
                                        <i class="bi bi-house text-secondary fs-4" title="Disponible - No alquilado"></i>
                                    }
                                    else
                                    {
                                        <input type="hidden" id="idInputDisponible" value="@inmueble.Disponible"/>
                                        <i class="bi bi-house-check-fill text-success fs-4" title="No disponible - Alquilado"></i>
                                        {
                                            var contratoVigente = Model.Contratos?.FirstOrDefault(c => c.IdInmueble == inmueble.IdInmueble && c.estado);
                                            if (contratoVigente != null)
                                            {
                                                <span class="badge bg-primary ms-1">Inicio: @contratoVigente.FechaInicio.ToString("dd/MM/yyyy")</span>
                                                <span class="badge bg-danger ms-1">Fin: @contratoVigente.FechaFin.ToString("dd/MM/yyyy")</span>
                                            }
                                        }
                                    }
                                }

                            </td>
                            <td class="text-center ">

                                @if (inmueble.Estado)
                                {
                                    <i class= "bi bi-check-circle-fill text-success fs-4" title = "Activo" ></i>
                                }
                                else
                                {
                                    <i class="bi bi-x-circle-fill text-danger fs-4" title="Inactivo - Dado de baja"></i>
                                }
                            </td>
                            <td class="text-center d-flex justify-content-space-between" style="padding-bottom: 33%;">
                                <a class="btn btn-warning p-1 m-1 w-25" href="@Url.Action("Actualizar", "Inmueble", new { idInmueble = inmueble.IdInmueble })">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                @if (inmueble.Estado)
                                {
                                    @if (inmueble.Disponible)
                                    {
                                        <button type="button" class="btn btn-info p-1 m-1 w-25" onclick="abrirNuevoContratoModal('@inmueble.IdInmueble', '@inmueble.Direccion')">
                                            <i class="bi bi-door-closed-fill"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-danger p-1 m-1 w-25" onclick="finalizarContrato('@inmueble.IdInmueble')">
                                            <i class="bi bi-door-open-fill"></i>
                                            
                                        </button>
                                        
                                        
                                        
                                    }
                                }
                                <!-- Botón para dar de baja o alta lógica -->
                                @if (inmueble.Disponible && inmueble.Estado || (!inmueble.Disponible && !inmueble.Estado))
                                {
                                    @if (inmueble.Estado)
                                    {
                                        <a class="btn btn-danger p-1 m-1 w-25" href="@Url.Action("DarBajaLogica", "Inmueble", new { idInmueble = inmueble.IdInmueble })">
                                            <i class="bi bi-trash-fill"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a class="btn btn-success p-1 m-1 w-25" href="@Url.Action("DarAltaLogica", "Inmueble", new { idInmueble = inmueble.IdInmueble })">
                                            <i class="bi bi-arrow-clockwise"></i>
                                        </a>
                                    }
                                }
                                @if (!inmueble.Disponible && inmueble.Estado)
                                {
                                    var contratoVigente = Model.Contratos?.FirstOrDefault(c => c.IdInmueble == inmueble.IdInmueble && c.estado);
                                    var inquilino = Model.inquilinos?.FirstOrDefault(i => i.IdInquilino == contratoVigente?.IdInquilino);
                                    var propietario = Model.propietarios?.FirstOrDefault(p => p.IdPropietario == contratoVigente?.IdPropietario);
                                    if (contratoVigente != null)
                                    {
                                        <button type="button" class="btn btn-outline-info p-1 m-1 w-25" data-bs-toggle="modal" data-bs-target="#modalContrato_@contratoVigente.IdContrato">
                                            <i class="bi bi-eye-fill"></i>
                                        </button>
                                        <!-- Modal para ver contrato MUESTRA TODOS LOS DATOS Q NO APARECEN EN LA TABLA-->
                                        <div class="modal fade" id="modalContrato_@contratoVigente.IdContrato" tabindex="-1" aria-labelledby="modalContratoLabel_@contratoVigente.IdContrato" aria-hidden="true">
                                            <div class="modal-dialog modal-lg">
                                                <div class="modal-content border-primary shadow-lg">
                                                    <div class="modal-header bg-primary text-white">
                                                        <h5 class="modal-title" id="modalContratoLabel_@contratoVigente.IdContrato">
                                                            <i class="bi bi-file-earmark-text me-2"></i>Datos del Contrato
                                                        </h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                                    </div>
                                                    <div class="modal-body bg-light">
                                                        <div class="row mb-3">
                                                            <div class="col-md-6 w-100 d-flex justify-content-center">
                                                                <div class="card border-success mb-3 w-50 overflow-auto">
                                                                    <div class="card-header bg-success text-white">Inquilino</div>
                                                                    <div class="card-body">
                                                                        <h6 class="card-title text-dark">@inquilino?.Nombre @inquilino?.Apellido</h6>
                                                                        <p class="card-text mb-0 text-dark"><strong>ID:</strong> @contratoVigente.IdInquilino</p>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <ul class="list-group mb-3">
                                                            <li class="list-group-item"><strong>ID Contrato:</strong> @contratoVigente.IdContrato</li>
                                                            <li class="list-group-item"><strong>Fecha Inicio:</strong> @contratoVigente.FechaInicio.ToString("dd/MM/yyyy")</li>
                                                            <li class="list-group-item"><strong>Fecha Fin:</strong> @contratoVigente.FechaFin.ToString("dd/MM/yyyy")</li>
                                                            <li class="list-group-item"><strong>Monto:</strong> $@contratoVigente.Monto</li>
                                                            <li class="list-group-item"><strong>Estado:</strong> @(contratoVigente.estado ? "Vigente" : "No vigente")</li>
                                                        </ul>
                                                    </div>
                                                    <div class="modal-footer bg-primary">
                                                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cerrar</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }

                            </td>
                        </tr>
                    }
                }                            
                        
                
            </tbody>
        </table>
    </div>
        <div class="col d-flex w-100 justify-content-between">
            <nav aria-label="Page navigation">
                
                <ul class="pagination">
                    @if (Pagina > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" id="btnAnterior" href="@Url.Action("GetAllInmuebles", "Inmueble", new { nroPagina = Pagina - 1 , disponibilidad = Disponibilidad, dniPropietario = DniPropietarioViewBag, uso = usoViewBag, tipo = tipoViewBag, cantAmbientes = cantAmbientesViewBag, precioAprox = precioAproxViewBag })" aria-label="Anterior">
                                <i class="bi bi-chevron-double-left"></i>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled" >
                            <span class="page-link"><i class="bi bi-chevron-double-left"></i></span>
                        </li>
                    }
                    @for(int i = 1; i <= Model!.cantidadTotalDePaginas; i++)
                    {
                        <li class="page-item @(i == Pagina ? "active" : "")">
                            <a class="page-link" href="@Url.Action("GetAllInmuebles", "Inmueble", new { nroPagina = @i , disponibilidad = Disponibilidad, dniPropietario = DniPropietarioViewBag , uso = usoViewBag, tipo = tipoViewBag, cantAmbientes = cantAmbientesViewBag, precioAprox = precioAproxViewBag})">@i</a>
                        </li>
                    }
                    @if (Pagina < Model.cantidadTotalDePaginas)
                    {
                        <li class="page-item">
                            <a class="page-link" id="btnSiguiente" href="@Url.Action("GetAllInmuebles", "Inmueble", new { nroPagina = Pagina + 1 , disponibilidad = Disponibilidad, dniPropietario = DniPropietarioViewBag, uso = usoViewBag, tipo = tipoViewBag, cantAmbientes = cantAmbientesViewBag, precioAprox = precioAproxViewBag})" aria-label="Siguiente">
                                <i class="bi bi-chevron-double-right"></i>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link">
                                <i class="bi bi-chevron-double-right">

                                </i>
                            </span>
                        </li>
                    }
                </ul>
            </nav>
            <button class="btn btn-danger h-100" onclick="window.location.href='/inmueble'">Volver</button>
        </div>
</div>

    <!-- Modal Nuevo Contrato -->
    <div class="modal fade" id="nuevoContratoModal" tabindex="-1" aria-labelledby="nuevoContratoModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="nuevoContratoModalLabel">Registrar Nuevo Contrato</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <form action="/contrato/crear" method="POST" class="p-3 border border-success mb-2 rounded" id="formContrato">
                        <input type="hidden" id="IdInquilino" name="IdInquilino">
                        <input type="hidden" id="IdPropietario" name="IdPropietario">
                        <div class="row mb-3">
                            <div class="col">
                                <label for="1">DNI Inquilino:</label>
                                <input type="text" id="dniInquilino" name="Dni" class="form-control" required>
                            </div>
                            <div class="col">
                                <label for="nombreInquilino">Nombre Inquilino:</label>
                                <input type="text" id="nombreInquilino" name="Nombre" class="form-control" required disabled>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col">
                                <label for="apellidoInquilino">Apellido Inquilino:</label>
                                <input type="text" id="apellidoInquilino" name="Apellido" class="form-control" required disabled>
                            </div>
                            <div class="col">
                                <label for="telefonoInquilino">Teléfono Inquilino:</label>
                                <input type="text" id="telefonoInquilino" name="Telefono" class="form-control" required disabled>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col">
                                <label for="direccionInquilino">Dirección Inquilino:</label>
                                <input type="text" id="direccionInquilino" name="Direccion" class="form-control" required disabled>
                            </div>
                            <div class="col">
                                <label for="emailInquilino">Email Inquilino:</label>
                                <input type="email" id="emailInquilino" name="Email" class="form-control" required disabled>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col">
                                <label for="direccionInmueble">Dirección Inmueble:</label>
                                <input type="text" id="direccionInmueble" name="direccionInmueble" class="form-control" required disabled>
                                <input type="hidden" id="idInmueble" name="idInmueble">
                            </div>
                            <div class="col">
                                <label for="fechaInicio">Fecha Inicio:</label>
                                <input type="date" id="fechaInicio" name="fechaInicio" class="form-control" required>
                            </div>
                            <div class="col">
                                <label for="fechaFin">Fecha Fin:</label>
                                <input type="date" id="fechaFin" name="fechaFin" class="form-control" required>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col">
                                <label for="Monto">Monto Alquiler:</label>
                                <input type="number" id="Monto" name="Monto" class="form-control" required>
                            </div>
                            <div class="col">
                                <label for="observaciones">Observaciones:</label>
                                <textarea id="observaciones" name="observaciones" class="form-control"></textarea>
                            </div>
                        </div>
                        <div class="mb-3 p-3 row border border-dark rounded w-100 ms-1">
                            <div class="col w-25">
                                <button class="btn btn-warning shadow ms-1 me-1 w-100" type="reset">Limpiar Formulario</button>
                            </div>
                            <div class="col w-25"></div>
                            <div class="col w-25"></div>
                            <div class="col w-25">
                                <button type="submit" class="btn btn-primary shadow ms-1 me-1 w-100">Registrar Contrato</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        function aplicarFiltrosv2() {
            const filtroDisponibilidad = document.getElementById('selectDisponible').value;
            const filtroDni = document.getElementById("inputDniFiltro").value;
            const filtroUso = document.getElementById('selectUso').value;
            const selectTipo = document.getElementById('selectTipo').value;
            const inputCantAmbientes = document.getElementById('inputCantAmbientes').value;
            const inputPrecioAproximado = document.getElementById('inputPrecioAproximado').value;
            const inputInicio = document.getElementById('inputInicioAlquiler').value;
            const inputFin = document.getElementById('inputFinAlquiler').value;
            const params = new URLSearchParams();
            if(filtroDisponibilidad !== '') {
                params.append('disponibilidad', filtroDisponibilidad);
            }
            if(filtroDni !== "" && filtroDni.length == 8){
                params.append('dniPropietario', filtroDni);
            }
            if(filtroUso !== '') {
                params.append('uso', filtroUso);
            }
            if(selectTipo !== '') {
                params.append('tipoInmueble', selectTipo);
            }
            if(inputCantAmbientes !== '') {
                params.append('cantAmbientes', inputCantAmbientes);
            }
            if(inputPrecioAproximado !== '' || inputPrecioAproximado.length != 0) {
                params.append('precio', inputPrecioAproximado);
            }
            if(inputInicio !== '' || inputInicio.length != 0) {
                params.append('fechaDesde', inputInicio);
            }
            if(inputFin !== '' || inputFin.length != 0) {
                params.append('fechaHasta', inputFin);
            }
            console.log(params.toString());
            alert(params.toString());
            window.location.href = `/inmueble/listar?${params.toString()}`;
           
        }
       
            function abrirNuevoContratoModal(id, direccion) {
                var modal = new bootstrap.Modal(document.getElementById('nuevoContratoModal'));
                document.getElementById('idInmueble').value = id;
                document.getElementById('direccionInmueble').value = direccion;
                // BUSCA EL INMUEBLE Y ASIGNA IDPROPIETARIO Y MONTO
                if (window.Model && window.Model.inmueble) {
                    var inmueble = window.Model.inmueble.find(i => i.IdInmueble == id);
                    console.log('Inmueble seleccionado al abrir modal:', inmueble);
                    if (inmueble && inmueble.IdPropietario) {
                        document.getElementById('IdPropietario').value = inmueble.IdPropietario;
                        console.log('IdPropietario asignado al abrir modal:', inmueble.IdPropietario);
                    } else {
                        document.getElementById('IdPropietario').value = '';
                        console.warn('No se encontró IdPropietario para el inmueble seleccionado');
                    }
                    // AUTORRELLENA MONTO CON EL PRECIO DEL INMUEBLE
                    var montoInput = document.getElementById('Monto');
                    if (montoInput && inmueble && inmueble.Precio) {
                        montoInput.value = inmueble.Precio;
                        console.log('Monto alquiler autorellenado con precio:', inmueble.Precio);
                    } else if (montoInput) {
                        montoInput.value = '';
                        console.warn('No se encontró precio para el inmueble seleccionado');
                    } else {
                        console.error("No se encontró el input 'Monto' en el DOM");
                    }
                } else {
                    console.warn('window.Model.inmueble no está disponible');
                }
                modal.show();
            }
            function actualizarContador(valor){
                sessionStorage.setItem('contador', valor);
                console.log('Contador actualizado:', valor);
            }
            function limpiarFiltrosv2() {
                const todosLosCampos = document.querySelectorAll("input , select");
                todosLosCampos.forEach( campo => {
                    if(campo.tagName == "SELECT"){
                        campo.selectedIndex = 0;
                    }else{
                        campo.value = "";
                    }
                })

                actualizarContador(0);
                aplicarFiltrosv2();
            }
            // GESTION DEL DNI DEL INQUILINO - FUNCIONA BIEN
            document.addEventListener('DOMContentLoaded', function() {
                const selectDisponibilidad = document.getElementById('selectDisponible');
                const inputInicio = document.getElementById('inputInicioAlquiler');
                const inputFin = document.getElementById('inputFinAlquiler');
                
                const dniInput = document.getElementById("dniInquilino");
                if (!dniInput) return;
                let inquilinoExiste = false;
                let idInquilinoActual = null;

                if(inputInicio && inputFin){
                    inputInicio.addEventListener('change', function() {
                        inputFin.min = this.value;
                        if(inputFin.value == ""){
                            inputFin.value = this.value;
                        }
                    });
                    inputFin.addEventListener('change', function() {
                        inputInicio.max = this.value;
                        if(inputInicio.value == ""){
                            inputInicio.value = this.value;
                        }
                    });
                }
                
                dniInput.addEventListener("input", function() {
                    const original = this.value;
                    const filtrado = original.replace(/[^0-9]/g, '');
                    if (original !== filtrado) {
                        const prevPlaceholder = this.placeholder;
                        this.value = filtrado;
                        this.placeholder = "SOLO NÚMEROS";
                        this.classList.add("placeholder-error");
                        this.style.color = "#dc3545";
                        this.style.fontWeight = "bold";
                        this.style.borderColor = "#dc3545";
                        setTimeout(() => {
                            this.classList.remove("placeholder-error");
                            this.placeholder = prevPlaceholder;
                            this.style.color = "";
                            this.style.fontWeight = "";
                            this.style.borderColor = "";
                        }, 900);
                    }
                    
                });
                /* document.getElementById("inputDniFiltro").addEventListener("input", function(){
                    if(this.value.length >= 8 || this.value.length == 0  || (this.value.length <= 7 && sessionStorage.getItem('contador') == 8) ){
                        aplicarFiltrosv2();
                    }
                    actualizarContador(this.value.length);
                });
                document.getElementById("selectUso").addEventListener("change", function() {
                    if(this.value != "" && this.value != "Todos los usos"){
                        aplicarFiltrosv2();
                    }
                });
                document.getElementById('selectTipo').addEventListener('change', function() {
                    if(this.value != "" && this.value != "Todos los tipos"){
                        aplicarFiltrosv2();
                    }
                })
                document.getElementById('inputCantAmbientes').addEventListener('focusout', function() {
                    if(this.value != "" ){
                        aplicarFiltrosv2();
                    }
                }) */
                dniInput.addEventListener("keyup", function() {
                    const dni = this.value;
                    if (dni.length >= 8) {
                        fetch('/Inquilino/BuscarPorDni?dni=' + dni)
                            .then(response => {
                                if (!response.ok) throw new Error('No se encontró la persona');
                                return response.json();
                            })
                            .then(data => {
                                document.getElementById('nombreInquilino').value = data.nombre || '';
                                document.getElementById('apellidoInquilino').value = data.apellido || '';
                                document.getElementById('telefonoInquilino').value = data.telefono || '';
                                document.getElementById('direccionInquilino').value = data.direccion || '';
                                document.getElementById('emailInquilino').value = data.email || '';
                                ['nombreInquilino','apellidoInquilino','telefonoInquilino','direccionInquilino','emailInquilino'].forEach(id => {
                                    document.getElementById(id).removeAttribute('disabled');
                                });
                                // SI ENCONTRAMOS EL INQUILINO POR DNI ASIGNAMOS SU ID AL CAMPO OCULTO Y RELLENAMOS LOS CAMPOS|
                                if (data.esInquilino) {
                                    if (data.idInquilino) {
                                        document.getElementById('IdInquilino').value = data.idInquilino;
                                        console.log('IdInquilino asignado al campo oculto (existente):', data.idInquilino);
                                    } else {
                                        document.getElementById('IdInquilino').value = '';
                                        console.warn('No se recibió idInquilino para el inquilino existente');
                                    }
                                    inquilinoExiste = true;
                                    idInquilinoActual = true;
                                } else {
                                    document.getElementById('IdInquilino').value = '';
                                    inquilinoExiste = false;
                                    idInquilinoActual = null;
                                }
                            })
                            .catch(() => {
                                document.getElementById('nombreInquilino').value = '';
                                document.getElementById('apellidoInquilino').value = '';
                                document.getElementById('telefonoInquilino').value = '';
                                document.getElementById('direccionInquilino').value = '';
                                document.getElementById('emailInquilino').value = '';
                                ['nombreInquilino','apellidoInquilino','telefonoInquilino','direccionInquilino','emailInquilino'].forEach(id => {
                                    document.getElementById(id).removeAttribute('disabled');
                                });
                                document.getElementById('IdInquilino').value = '';
                                inquilinoExiste = false;
                                idInquilinoActual = null;
                            });
                    } else {
                        document.getElementById('nombreInquilino').value = '';
                        document.getElementById('apellidoInquilino').value = '';
                        document.getElementById('telefonoInquilino').value = '';
                        document.getElementById('direccionInquilino').value = '';
                        document.getElementById('emailInquilino').value = '';
                        ['nombreInquilino','apellidoInquilino','telefonoInquilino','direccionInquilino','emailInquilino'].forEach(id => {
                            document.getElementById(id).setAttribute('disabled', 'disabled');
                        });
                        document.getElementById('IdInquilino').value = '';
                        inquilinoExiste = false;
                        idInquilinoActual = null;
                    }
                });
                
                // HABILITAMOS LOS CAMPOS PARA ENVIAR EL FORMULARIO
                document.getElementById('formContrato').addEventListener('submit', async function(e) {
                    ['nombreInquilino','apellidoInquilino','telefonoInquilino','direccionInquilino','emailInquilino'].forEach(id => {
                        document.getElementById(id).removeAttribute('disabled');
                    });
                    // ASIGNA IDPROPIETARIO AL CAMPO OCULTO
                    var idProp = null;
                    if (window.Model && window.Model.inmueble) {
                        var idInmueble = document.getElementById('idInmueble').value;
                        var inmueble = window.Model.inmueble.find(i => i.IdInmueble == idInmueble);
                        console.log('Objeto inmueble seleccionado:', inmueble);
                        if (inmueble && inmueble.IdPropietario) {
                            idProp = inmueble.IdPropietario;
                        }
                    }
                    document.getElementById('IdPropietario').value = idProp || '';
                    console.log('IdPropietario asignado al campo oculto:', document.getElementById('IdPropietario').value);

                    // SI NO EXISTE EL INQUILINO, LO CREA Y ESPERA PARA OBTENER SU ID
                    if (!inquilinoExiste) {
                        e.preventDefault();
                        // CREAMOS EL INQUILINO CON PREVENT REDIRECT PARA NO CORTAR EL FLUJO
                        const formData = new FormData();
                        formData.append('Dni', document.getElementById('dniInquilino').value);
                        formData.append('Nombre', document.getElementById('nombreInquilino').value);
                        formData.append('Apellido', document.getElementById('apellidoInquilino').value);
                        formData.append('Telefono', document.getElementById('telefonoInquilino').value);
                        formData.append('Direccion', document.getElementById('direccionInquilino').value);
                        formData.append('Email', document.getElementById('emailInquilino').value);
                        console.log('Enviando datos para crear inquilino:', Object.fromEntries(formData.entries()));
                        fetch('/inquilino/Create?preventRedirect=true', {
                            method: 'POST',
                            body: formData
                        }).then(async resp => {
                            // AWAITEA Q SE CREE Y LUEGO BUSCA EL ID
                            const dni = document.getElementById('dniInquilino').value;
                            setTimeout(async () => {
                                try {
                                    const resp2 = await fetch('/Inquilino/BuscarPorDni?dni=' + dni);
                                    if (resp2.ok) {
                                        const data = await resp2.json();
                                        console.log('Respuesta de BuscarPorDni:', data);
                                        if (data.esInquilino && data.idInquilino) {
                                            document.getElementById('IdInquilino').value = data.idInquilino;
                                            inquilinoExiste = true;
                                            console.log('IdInquilino obtenido y asignado al campo oculto:', document.getElementById('IdInquilino').value);
                                            // REENVIA EL FORMULARIO CONTRATO
                                            document.getElementById('formContrato').submit();
                                        } else {
                                            console.error('No se pudo obtener el id del nuevo inquilino. Verifique que el backend devuelva idInquilino en /Inquilino/BuscarPorDni');
                                        }
                                    } else {
                                        console.error('Error al buscar el nuevo inquilino.');
                                    }
                                } catch (err) {
                                    console.error('Error inesperado al buscar el nuevo inquilino.', err);
                                }
                            }, 1000);
                        }).catch(() => {
                            console.error('Error al crear el inquilino.');
                        });
                    } else {
                        // SI EL INQUILINO YA EXISTE, ASEGURA LA ASIGNACION DEL ID
                        if (!document.getElementById('IdInquilino').value) {
                            const dni = document.getElementById('dniInquilino').value;
                            const resp = await fetch('/Inquilino/BuscarPorDni?dni=' + dni);
                            if (resp.ok) {
                                const data = await resp.json();
                                console.log('Respuesta de BuscarPorDni (inquilino ya existe):', data);
                                if (data.idInquilino) {
                                    document.getElementById('IdInquilino').value = data.idInquilino;
                                    console.log('IdInquilino asignado al campo oculto:', document.getElementById('IdInquilino').value);
                                } else {
                                    console.error('No se encontró idInquilino en la respuesta.');
                                }
                            } else {
                                console.error('Error al buscar el inquilino existente.');
                            }
                        } else {
                            console.log('IdInquilino ya presente en el campo oculto:', document.getElementById('IdInquilino').value);
                        }
                    }
                    // ANTES DE ENVIAR EL FORMULARIO, CONSOLOGUEA LOS VALORES FINALES ENVIADOS AL BACKEND
                    console.log('Valores finales antes de enviar el contrato:', {
                        IdInquilino: document.getElementById('IdInquilino').value,
                        IdPropietario: document.getElementById('IdPropietario').value
                    });
                });
                // VALIDACIÓN DE FECHAS EN FORMULARIO DE CONTRATO
                const fechaInicioInput = document.getElementById('fechaInicio');
                const fechaFinInput = document.getElementById('fechaFin');
                
                let tomorrow = new Date();
                     
                // CUANDO CAMBIAMOS LA FECHA DE INICIO, LA DE FIN SE AJUSTA Y SE AUTOSELECCIONA EN MAÑANA
                fechaInicioInput.addEventListener('change', function() {
                    let minFin = new Date(this.valueAsDate);
                    minFin.setDate(minFin.getDate());
                    let minFinStr = minFin.toISOString().split('T')[0];
                    fechaFinInput.setAttribute('min', minFinStr);
                    fechaFinInput.value = minFinStr;
                });
                
            });
            function confirmarEliminacion(url, nombre) {
                Swal.fire({
                    title: '¿Estás seguro?',
                    html: `Vas a eliminar: <b>${nombre}</b>`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Sí, eliminar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = url;
                    }
                });

                // Return false para prevenir el comportamiento por defecto
                return false;
            }
            async function finalizarContrato(idInmueble) {
                var idContrato = null;
                // BUSCAMOS EL CONTRATO VIGENTE POR EL ID INMUEBLE
                await fetch(`/contrato/getContratoByIdInmueble/${idInmueble}`)
                    .then(response => {
                        if (!response.ok) throw new Error('No se encontró el contrato');
                        return response.json();
                    })
                    .then(data => {
                    if (data && Array.isArray(data) && data.length > 0 && data[0].idContrato) {
                        idContrato = data[0].idContrato;
                    } else {
                        console.error('No se encontró un contrato vigente para este inmueble.');
                        Swal.fire('Error', 'No se encontró un contrato vigente para este inmueble.', 'error');
                        return false;
                    }
                })
                    .catch(() => {
                        console.error('Error al buscar el contrato por IdInmueble.');
                        Swal.fire('Error', 'Error al buscar el contrato por IdInmueble.', 'error');
                        return false;
                    });
                Swal.fire({
                    title: '¿Estás seguro?',
                    text: "Vas a finalizar este contrato.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Sí, finalizar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        
                        window.location.href = `/contrato/dardebaja/${idContrato}`;
                    }
                });

                
                return false;
            }
    </script>
@model project.Models.ViewModels.InmuebleViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div>
    <h2 class="text-center mt-4 text-white fs-2 mt-1">Lista de Inmuebles Registrados</h2>
    <div class="table-responsive">
        <table class="table table-striped table-bordered mt-4 table-dark mb-3 ">
            <thead class="table-dark">
                <tr>
                    <th style="width: 3%;">ID</th>
                    <th style="width: 5%;">Uso</th>
                    <th style="width: 5%;">Tipo</th>
                    <th style="width: 3%;">Sup</th>
                    <th style="width: 3%;">Amb</th>
                    <th style="width: 5%;">Coord</th>
                    <th style="width: 5%;">Precio</th>
                    <th style="width: 10%;">Dirección</th>
                    <th style="width: 10%;">Propietario</th>
                    <th style="width: 5%;">DNI Prop</th>
                    <th style="width: 5%;">Alquilado</th>
                    <th style="width: 5%;">Estado</th>
                    <th style="width: 12%;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.inmueble != null && Model.tipo_Inmueble != null )
                {
                    foreach (var inmueble in Model.inmueble)
                    {
                        
                        <tr>
                            <td class="text-center ">@inmueble.IdInmueble</td>
                            <td class="text-center ">@inmueble.Uso</td>
                            <td class="text-center ">@inmueble.Tipo.nombre</td>
                            <td class="text-center ">@inmueble.Superficie</td>
                            <td class="text-center ">@inmueble.CantidadAmbientes</td>
                            <td class="text-center ">@inmueble.Coordenadas</td>
                            <td class="text-center ">$@inmueble.Precio</td>
                            <td class="text-center ">@inmueble.Direccion</td>
                            <td class="text-center ">@inmueble.Propietario!.Nombre @inmueble.Propietario.Apellido</td>
                            <td class="text-center ">@inmueble.Propietario!.Dni</td>
                            <td class="text-center flex">
                                @if (!inmueble.estado)
                                {
                                    <i class="bi bi-house-slash-fill text-danger fs-4" title="No disponible - Dado de baja"></i>
                                }
                                else
                                {
                                    @if (inmueble.Disponible)
                                    {
                                        <i class="bi bi-house text-secondary fs-4" title="Disponible - No alquilado"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-house-check-fill text-success fs-4" title="Alquilado"></i>
                                    }
                                }

                            </td>
                            <td class="text-center flex">
                                @if (inmueble.estado)
                                {
                                    <i class= "bi bi-check-circle-fill text-success fs-4" title = "Activo" ></i>
                                }
                                else
                                {
                                    <i class="bi bi-x-circle-fill text-danger fs-4" title="Inactivo - Dado de baja"></i>
                                }
                            </td>
                            <td class="text-center d-flex justify-content-space-between pb-4">
                                <a class="btn btn-warning p-1 m-1 w-25" href="@Url.Action("Actualizar", "Inmueble", new { idInmueble = inmueble.IdInmueble })">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                @if (inmueble.estado)
                                {
                                    @if (inmueble.Disponible)
                                    {
                                        <a class="btn btn-info p-1 m-1 w-25" href="@Url.Action("MarcarAlquilado", "Inmueble", new { idInmueble = inmueble.IdInmueble })">
                                            <i class="bi bi-door-closed-fill"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a class="btn btn-success p-1 m-1 w-25" href="@Url.Action("MarcarLibre", "Inmueble", new { idInmueble = inmueble.IdInmueble })">
                                            <i class="bi bi-door-open-fill"></i>
                                        </a>
                                    }
                                }
                                @if (inmueble.Disponible && inmueble.estado || (!inmueble.Disponible && !inmueble.estado))
                                {
                                    @if (inmueble.estado)
                                    {
                                        <a class="btn btn-danger p-1 m-1 w-25" href="@Url.Action("DarBajaLogica", "Inmueble", new { idInmueble = inmueble.IdInmueble })">
                                            <i class="bi bi-trash-fill"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a class="btn btn-success p-1 m-1 w-25" href="@Url.Action("DarAltaLogica", "Inmueble", new { idInmueble = inmueble.IdInmueble })">
                                            <i class="bi bi-arrow-clockwise"></i>
                                        </a>
                                    }
                                }

                            </td>
                        </tr>
                    }
                }                            
                        
                
            </tbody>
        </table>

    </div>
</div>
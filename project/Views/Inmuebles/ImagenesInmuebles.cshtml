@model project.Models.ViewModels.InmuebleViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Imagenes Inmuebles";
    var imagenPortada = ViewBag.ImagenPortada as string;
    var imagenes = ViewBag.Imagenes as List<string>;
    var inmueble = ViewBag.Inmueble as Inmueble;
}
<style>
    .img-hover {
        transition: transform 0.2s ease;
        cursor: pointer;
    }
    .img-hover:hover {
        transform: scale(1.08);
        z-index: 2;
        box-shadow: 0 0 20px rgba(0,0,0,0.2);
    }
    .modal-img {
        max-width: 90vw;
        max-height: 80vh;
        object-fit: contain;
    }
</style>

<!-- Encabezado -->
<div class="container mb-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-sm mb-2 border-dark rounded shadow" style="background:#5e5f60;">
                <div class="card-body d-flex flex-wrap align-items-center">
                    <div class="row w-100">
                        <h4 class="mb-1 col w-25 text-light">@inmueble?.Direccion</h4>
                        <span class="me-3 col w-25 text-light"><strong>Precio: $</strong> @inmueble?.Precio.ToString()</span>
                        
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container py-4">
    <div class="row justify-content-center align-items-stretch">
        <div class="col-md-5 d-flex flex-column justify-content-center">
            <div class="h-100 w-100 shadow rounded overflow-hidden" style="background:#f8f9fa;">
                @if (!string.IsNullOrEmpty(imagenPortada)) {
                    <img src="@imagenPortada" alt="Portada" class="img-hover" style="width:100%;height:100%;object-fit:cover;min-height:400px;max-height:600px;" onclick="showModal('@imagenPortada')" />
                } else {
                    <div class="d-flex align-items-center justify-content-center h-100" style="min-height:400px;">
                        <span class="text-muted">No hay imagen de portada</span>
                    </div>
                }
            </div>
        </div>
        <div class="col-md-7">
            <div class="row g-3">
                @if (imagenes != null && imagenes.Count > 0) {
                    @foreach (var img in imagenes.Take(6)) {
                        <div class="col-6 col-md-4">
                            <div class="shadow rounded overflow-hidden h-100" style="background:#f8f9fa;">
                                <img src="@img" alt="Imagen inmueble" class="img-hover" style="width:100%;height:200px;object-fit:cover;" onclick="showModal('@img')" />

                            </div>
                        </div>
                    }
                } else {
                    <div class="col-12 text-center">
                        <span class="text-muted">No hay imágenes adicionales</span>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="row mt-4 justify-content-center">
        <div class="col-md-4 text-center">
            <button class="btn btn-outline-primary w-100" onclick="window.history.back();">
                <i class="bi bi-arrow-left"></i> Volver a la lista
            </button>
        </div>
    </div>
</div>
<!-- Modal para imagen grande -->
<div class="modal fade" id="imgModal" tabindex="-1" aria-labelledby="imgModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content bg-dark">
            <div class="modal-header border-0">
                <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body d-flex justify-content-center align-items-center p-0" style="height:100vh;">
                <img id="modalImg" src="" alt="Imagen grande" style="max-width:100vw;max-height:100vh;object-fit:contain;display:block;margin:auto;" />
            </div>
        </div>
    </div>
</div>
<script>
        function showModal(src) {
                var modalImg = document.getElementById('modalImg');
                modalImg.src = src;
                var myModal = new bootstrap.Modal(document.getElementById('imgModal'));
                myModal.show();
        }
</script>
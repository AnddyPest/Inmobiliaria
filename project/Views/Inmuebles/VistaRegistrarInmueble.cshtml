
@{
    ViewData["Title"] = "VistaRegistrarInmueble";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card rounded">
    <div class="card-header">
        <h2 class="card-title">Registrar Inmueble</h2>
        <p class="card-text">Aquí puedes registrar un nuevo inmueble.</p>
    </div>
    
    <div class="row card-body">
        <form action="/" method="post">
            <div class="mb-3">
                <label for="Uso" class="form-label" >Uso</label>
                <input class="form-control" type="text" name="Uso" placeholder="Ingrese el uso del inmueble" required />
            </div>
            <div class="mb-3">
                
                <select class="form-select">
                    <option selected>Seleccione el Tipo de Inmueble</option>
                </select>
            </div>
            <div class="mb-3">
                <label for="Superficie" class="form-label">Superficie (m²)</label>
                <input type="number" name="Superficie" class="form-control"/>
            </div>
            <div class="mb-3">
                <label for="CantAmbientes" class="form-label">Cantidad de Ambientes</label>
                <input type="number" name="CantAmbientes" class="form-control" />
            </div>
            <div class="mb-3">
                <label for="Coordenadas" class="form-label">Coordenadas</label>
                <input class="form-control" type="number" step="0.01" min="0" name="Coordenadas" placeholder="Ingrese las coordenadas del inmueble" required />
            </div>
            <div class="mb-3">
                <label for="Precio" class="form-label">Precio</label>
                <input class="form-control" type="number" step="0.01" min="0" name="Precio" placeholder="Ingrese el precio del inmueble" required />
            </div>
            <div class="mb-3">
                <label for="Direccion" class="form-label">Direccion</label>
                <input class="form-control" type="text" name="Direccion" placeholder="Ingrese la dirección del inmueble" required />
            </div>
            <div class="mb-3">
                <label for="ciudad" class="form-label">Ciudad</label>
                <select class="form-select" name="ciudad" required>
                    <option selected>Seleccione una ciudad</option>
                </select>
            </div>
            <div class="mb-3">
                <label for="IdPropietario" class="form-label">Selecciona el propietario</label>
                <select class="form-select" name="IdPropietario" required>
                    <option selected>Seleccione un propietario</option>
                </select>
            </div>
            <div class="mb-3">
                <select name="estado" class="form-select" required>
                    <option selected>Seleccione el estado del inmueble</option>
                    <option value="true">Disponible</option>
                    <option value="false">No Disponible</option>
                </select>
            </div>
            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Registrar Inmueble</button>
            </div>
           
        </form>
    </div>
</div>


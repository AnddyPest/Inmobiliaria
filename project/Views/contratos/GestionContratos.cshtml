                        @* <li class="page-item">
                            <a class="page-link" href="@Url.Action("GetAllContratos", "Contrato", new { nroPagina = Pagina + 1, disponibilidad = disponibilidad, fechaCompare = fechaCompare  })" aria-label="Siguiente">
                                <i class="bi bi-chevron-double-right"></i>

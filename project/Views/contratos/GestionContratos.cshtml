@model project.Models.ViewModels.ContratoViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var Pagina = ViewBag.nroPagina ?? 1;
}
@using Newtonsoft.Json
<script>
    window.Model = {
        contratos: @Html.Raw(JsonConvert.SerializeObject(Model.contratos))
    };
</script>

<div>
    <h2 class="text-center mt-4 text-white fs-2 mt-1">Lista de Contratos Registrados</h2>
    <div class="table-container" style="min-height: 320px;">
        <table class="table table-striped table-bordered mt-4 table-dark mb-3" id="contratosTable">
            <thead class="table-dark">
                <tr>
                    <th style="width: 5%;">ID</th>
                    <th style="width: 10%;">Inquilino</th>
                    <th style="width: 10%;">Propietario</th>
                    <th style="width: 10%;">Inmueble</th>
                    <th style="width: 10%;">Fecha Inicio</th>
                    <th style="width: 10%;">Fecha Fin</th>
                    <th style="width: 10%;">Monto</th>
                    <th style="width: 10%;">Estado</th>
                    <th style="width: 15%;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.contratos != null)
                {
                    foreach (var contrato in Model.contratos)
                    {
                        var inquilino = Model.inquilinos?.FirstOrDefault(i => i.IdInquilino == contrato.IdInquilino);
                        var propietario = Model.propietarios?.FirstOrDefault(p => p.IdPropietario == contrato.IdPropietario);
                        var inmueble = Model.inmueble?.FirstOrDefault(i => i.IdInmueble == contrato.IdInmueble);
                        <tr>
                            <td class="text-center">@contrato.IdContrato</td>
                            <td class="text-center">@inquilino?.Nombre @inquilino?.Apellido</td>
                            <td class="text-center">@propietario?.Nombre @propietario?.Apellido</td>
                            <td class="text-center">@inmueble?.Direccion</td>
                            <td class="text-center">@contrato.FechaInicio.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">@contrato.FechaFin.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">$@contrato.Monto</td>
                            <td class="text-center">@(contrato.estado ? "Vigente" : "No vigente")</td>
                            <td class="text-center d-flex justify-content-space-between">
                                <!-- BOTÓN EDITAR CONTRATO -->
                                <a class="btn btn-warning p-1 m-1 w-25" href="#">
                                    <i class="bi bi-pencil-square"></i> <!-- EDITAR CONTRATO -->
                                </a>
                                <!-- BOTÓN DAR DE BAJA CONTRATO -->
                                <a class="btn btn-danger p-1 m-1 w-25" href="#">
                                    <i class="bi bi-trash-fill"></i> <!-- DAR DE BAJA CONTRATO -->
                                </a>
                                <!-- BOTÓN VER DETALLE CONTRATO -->
                                <button type="button" class="btn btn-outline-info p-1 m-1 w-25" data-bs-toggle="modal" data-bs-target="#modalContrato_@contrato.IdContrato">
                                    <i class="bi bi-eye-fill"></i> <!-- VER DETALLE CONTRATO -->
                                </button>
                                <!-- MODAL DETALLE CONTRATO -->
                                <div class="modal fade" id="modalContrato_@contrato.IdContrato" tabindex="-1" aria-labelledby="modalContratoLabel_@contrato.IdContrato" aria-hidden="true">
                                    <div class="modal-dialog modal-lg">
                                        <div class="modal-content border-primary shadow-lg">
                                            <div class="modal-header bg-primary text-white">
                                                <h5 class="modal-title" id="modalContratoLabel_@contrato.IdContrato">
                                                    <i class="bi bi-file-earmark-text me-2"></i>Datos del Contrato
                                                </h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                            </div>
                                            <div class="modal-body bg-light">
                                                <ul class="list-group mb-3">
                                                    <li class="list-group-item"><strong>ID Contrato:</strong> @contrato.IdContrato</li>
                                                    <li class="list-group-item"><strong>Inquilino:</strong> @inquilino?.Nombre @inquilino?.Apellido</li>
                                                    <li class="list-group-item"><strong>Propietario:</strong> @propietario?.Nombre @propietario?.Apellido</li>
                                                    <li class="list-group-item"><strong>ID Inmueble:</strong> @contrato.IdInmueble</li>
                                                    <li class="list-group-item"><strong>Fecha Inicio:</strong> @contrato.FechaInicio.ToString("dd/MM/yyyy")</li>
                                                    <li class="list-group-item"><strong>Fecha Fin:</strong> @contrato.FechaFin.ToString("dd/MM/yyyy")</li>
                                                    <li class="list-group-item"><strong>Monto:</strong> $@contrato.Monto</li>
                                                    <li class="list-group-item"><strong>Estado:</strong> @(contrato.estado ? "Vigente" : "No vigente")</li>
                                                </ul>
                                            </div>
                                            <div class="modal-footer bg-primary">
                                                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cerrar</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        <div class="col d-flex w-100 justify-content-between">
            <nav aria-label="Page navigation">
                <ul class="pagination">
                    @if (Pagina > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("GetAllContratos", "Contrato", new { nroPagina = Pagina - 1 })" aria-label="Anterior">
                                <i class="bi bi-chevron-double-left"></i>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link"><i class="bi bi-chevron-double-left"></i></span>
                        </li>
                    }
                    @for (int i = 1; i <= Model!.cantidadTotalDePaginas; i++)
                    {
                        <li class="page-item @(i == Pagina ? "active" : "")">
                            <a class="page-link" href="@Url.Action("GetAllContratos", "Contrato", new { nroPagina = i })">@i</a>
                        </li>
                    }
                    @if (Pagina < Model.cantidadTotalDePaginas)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("GetAllContratos", "Contrato", new { nroPagina = Pagina + 1 })" aria-label="Siguiente">
                                <i class="bi bi-chevron-double-right"></i>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link"><i class="bi bi-chevron-double-right"></i></span>
                        </li>
                    }
                </ul>
            </nav>
            <button class="btn btn-danger h-100" onclick="window.location.href='/contrato'">Volver</button>
        </div>
    </div>
</div>
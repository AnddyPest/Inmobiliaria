@model project.Models.ViewModels.ContratoViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var Pagina = ViewBag.nroPagina ?? 1;
}
@using Newtonsoft.Json

<script>
    window.Model = {
        contratos: @Html.Raw(JsonConvert.SerializeObject(Model.contratos))
    };
</script>

<div>
    <h2 class="text-center mt-4 text-white fs-2 mt-1">Lista de Contratos Registrados</h2>
@{
    var disponibilidad = Context.Request.Query["disponibilidad"].FirstOrDefault() ?? "";
}
<!-- FILTRO POR DISPONIBILIDAD -->
<form method="get" asp-action="GetAllContratos" class="mb-3" id="filtroForm">
    <div class="btn-group" role="group" aria-label="Filtrar por disponibilidad">
        <input type="radio" class="btn-check" name="disponibilidad" id="todos" value="" @(disponibilidad == "" ? "checked" : "")>
        <label class="btn btn-outline-primary" for="todos">Todos</label>
        <input type="radio" class="btn-check" name="disponibilidad" id="vigente" value="vigente" @(disponibilidad == "vigente" ? "checked" : "")>
        <label class="btn btn-outline-success" for="vigente">Vigentes</label>
        <input type="radio" class="btn-check" name="disponibilidad" id="no_vigente" value="no_vigente" @(disponibilidad == "no_vigente" ? "checked" : "")>
        <label class="btn btn-outline-danger" for="no_vigente">No vigentes</label>
    </div>
</form>
<!-- SCRIPT DE LOS FILTROS POR DISPONIBILIDAD -->
<script>
    document.querySelectorAll('input[name="disponibilidad"]').forEach(function(radio) {
        radio.addEventListener('change', function() {
            document.getElementById('filtroForm').submit();
        });
    });
</script>
    
    <div class="table-container" style="min-height: 320px;">
        <table class="table table-striped table-bordered mt-4 table-dark mb-3" id="contratosTable">
            <thead class="table-dark">
                <tr>
                    <th style="width: 5%;">ID</th>
                    <th style="width: 10%;">Inquilino</th>
                    <th style="width: 10%;">Propietario</th>
                    <th style="width: 10%;">Inmueble</th>
                    <th style="width: 10%;">Fecha Inicio</th>
                    <th style="width: 10%;">Fecha Fin</th>
                    <th style="width: 10%;">Monto</th>
                    <th style="width: 10%;">Estado</th>
                    <th style="width: 15%;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.contratos != null)
                {
                    foreach (var contrato in Model.contratos)
                    {
                        var inquilino = Model.inquilinos?.FirstOrDefault(i => i.IdInquilino == contrato.IdInquilino);
                        var propietario = Model.propietarios?.FirstOrDefault(p => p.IdPropietario == contrato.IdPropietario);
                        var inmueble = Model.inmueble?.FirstOrDefault(i => i.IdInmueble == contrato.IdInmueble);
                        <tr>
                            <td class="text-center">@contrato.IdContrato</td>
                            <td class="text-center">@inquilino?.Nombre @inquilino?.Apellido</td>
                            <td class="text-center">@propietario?.Nombre @propietario?.Apellido</td>
                            <td class="text-center">@inmueble?.Direccion</td>
                            <td class="text-center">@contrato.FechaInicio.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">@contrato.FechaFin.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">$@contrato.Monto</td>
                            <td class="text-center">
                                @if (contrato.estado)
                                {
                                    <span class="text-success">
                                        <i class="bi bi-check-circle-fill" style="font-size: 1.3em;"></i>
                                    </span>
                                }
                                else
                                {
                                    <span class="text-danger">
                                        <i class="bi bi-x-circle-fill" style="font-size: 1.3em;"></i>
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                <!-- BOTÓN EDITAR CONTRATO -->
                                <a class="btn btn-warning p-1 m-1 w-25" href="#">
                                    <i class="bi bi-pencil-square"></i> <!-- EDITAR CONTRATO -->
                                </a>
                                <!-- BOTÓN DE IR A PAGOS -->
                                <a class="btn btn-success p-1 m-1 w-25" href="#">
                                    <i class="bi bi-cash-stack"></i> <!-- IR A PAGOS -->
                                </a>
                                
                                
                                
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        <div class="col d-flex w-100 justify-content-between">
            <nav aria-label="Page navigation">
                <ul class="pagination">
                    @if (Pagina > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("GetAllContratos", "Contrato", new { nroPagina = Pagina - 1, disponibilidad = disponibilidad })" aria-label="Anterior">
                                <i class="bi bi-chevron-double-left"></i>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link"><i class="bi bi-chevron-double-left"></i></span>
                        </li>
                    }
                    @for (int i = 1; i <= Model!.cantidadTotalDePaginas; i++)
                    {
                        <li class="page-item @(i == Pagina ? "active" : "")">
                            <a class="page-link" href="@Url.Action("GetAllContratos", "Contrato", new { nroPagina = i, disponibilidad = disponibilidad })">@i</a>
                        </li>
                    }
                    @if (Pagina < Model.cantidadTotalDePaginas)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("GetAllContratos", "Contrato", new { nroPagina = Pagina + 1, disponibilidad = disponibilidad })" aria-label="Siguiente">
                                <i class="bi bi-chevron-double-right"></i>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link"><i class="bi bi-chevron-double-right"></i></span>
                        </li>
                    }
                </ul>
            </nav>
            <button class="btn btn-danger h-100" onclick="window.location.href='/contrato'">Volver</button>
        </div>
    </div>
</div>
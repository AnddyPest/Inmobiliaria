<div class="modal fade" id="modalRenovarFechaFin" tabindex="-1" aria-labelledby="modalRenovarLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            
            <form method="post" action="/contrato/renovarContrato" id="formRenovarContrato">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="modalRenovarLabel">Renovar Contrato</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="nuevaFechaInicio" class="form-label">Nueva Fecha de Inicio</label>
                        <input type="date" id="nuevaFechaInicio" name="FechaInicio" class="form-control" readonly />
                    </div>
                    <div class="mb-3">
                        <label for="nuevaFechaFin" class="form-label">Nueva Fecha de Fin</label>
                        <input type="date" id="nuevaFechaFin" name="FechaFin" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label for="nuevoMonto" class="form-label">Monto</label>
                        <input type="number" id="nuevoMonto" name="Monto" class="form-control" min="1" required />
                    </div>
                    
                    <input type="hidden" id="hiddenIdContrato" name="IdContrato" />
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Confirmar Renovación</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                </div>
            </form>
        </div>
    </div>
</div>




<div>
    <h2 class="text-center mt-4 text-white fs-2">Lista de Contratos Registrados</h2>
</div>
@{
    var disponibilidad = Context.Request.Query["disponibilidad"].FirstOrDefault() ?? "";
    var fechaCompare = Context.Request.Query["fechaCompare"].FirstOrDefault() ?? "";
}
<!-- FILTRO POR DISPONIBILIDAD -->
<div class="d-flex justify-content-start mt-4 mb-3 w-100 align-items-center">
    <div class="w-25 ms-2">
        <form method="get" asp-action="GetAllContratos" class="" id="filtroForm">
            <div class="btn-group" role="group" aria-label="Filtrar por disponibilidad">
                <input type="radio" class="btn-check" name="disponibilidad" id="todos" onchange="pagina = 1; actualizarContenido()" value=""   @(disponibilidad == "" ? "checked" : "" )>
                <label class="btn btn-outline-primary" for="todos">Todos</label>
                <input type="radio" class="btn-check" name="disponibilidad" id="vigente" onchange="pagina = 1; actualizarContenido()" value="vigente" @(disponibilidad == "vigente" ? "checked" : "")>
                <label class="btn btn-outline-success" for="vigente">Vigentes</label>
                <input type="radio" class="btn-check" name="disponibilidad" id="no vigente" onchange="pagina = 1; actualizarContenido()" value="no vigente" @(disponibilidad == "no vigente" ? "checked" : "")>
                <label class="btn btn-outline-danger" for="no vigente">No vigentes</label>
            </div>
            <input type="hidden" name="fechaCompare" value="@fechaCompare" />
        </form>
    </div>
    @* <div class="w-25"></div> *@
    @* <div class="w-25"></div> *@
    <div class="w-50 text-center ">
        <input type="text"  id="inputFiltroInmueble" class="form-control" placeholder="Buscar por inmueble (Direccion del inmueble)" aria-label="Buscar por inmueble">
    </div>
    <!-- FILTRO POR FECHA DE VENCIMIENTO -->
    <div class="w-25 ms-5">
        <form method="get" asp-action="GetAllContratos" class="me-3" id="fechaCompareForm">
        
            <div class="btn-group" role="group" aria-label="Filtrar por fecha">
                <input type="radio" class="btn-check" onchange="pagina = 1; actualizarContenido()" name="fechaCompare" id="dias30" value="30" @(fechaCompare == "30" ? "checked" : "")>
                <label class="btn btn-outline-danger" for="dias30">30 Días</label>
                <input type="radio" class="btn-check" onchange="pagina = 1; actualizarContenido()" name="fechaCompare" id="dias60" value="60" @(fechaCompare == "60" ? "checked" : "")>
                <label class="btn btn-outline-warning" onchange="pagina = 1; actualizarContenido()" for="dias60">60 Días</label>
                <input type="radio" class="btn-check" onchange="pagina = 1; actualizarContenido()" name="fechaCompare" id="dias90" value="90" @(fechaCompare == "90" ? "checked" : "")>
                <label class="btn btn-outline-success" for="dias90">90 Días</label>
            </div>
            <input type="hidden" name="disponibilidad" value="@disponibilidad" />
        </form>
    </div>
   
</div>
<script>
    let pagina = @Pagina;
    let ultimaDisponibilidadSeleccionada = document.querySelector('input[name="disponibilidad"]:checked')?.value || '';

     document.querySelectorAll('input[name="disponibilidad"]').forEach(function(radio) {
        radio.addEventListener('change', function() {
            //document.getElementById('filtroForm').submit();
            if(radio.value == ultimaDisponibilidadSeleccionada){
                radio.checked = false;
                ultimaDisponibilidadSeleccionada = '';
                actualizarContenido();
            }else{
                ultimaDisponibilidadSeleccionada = radio.value;
                actualizarContenido();
            }
        });
    }); 
    // Filtro de fecha: deselecciona si se hace click en el mismo
    let lastFechaCompare = document.querySelector('input[name="fechaCompare"]:checked')?.value || null;
    document.querySelectorAll('input[name="fechaCompare"]').forEach(function(radio) {
        radio.addEventListener('click', function(e) {
            let form = document.getElementById('fechaCompareForm');
            if (lastFechaCompare === radio.value) {
                radio.checked = false;
                lastFechaCompare = "";
                //document.querySelectorAll('input[name="fechaCompare"]').forEach(r => r.checked = false);
                let hidden = form.querySelector('input[type="hidden"][name="fechaCompare"]');
                if (!hidden) {
                    hidden = document.createElement('input');
                    hidden.type = 'hidden';
                    hidden.name = 'fechaCompare';
                    form.appendChild(hidden);
                }
                hidden.value = '';
                actualizarContenido()
                //form.submit();
            } else {
                lastFechaCompare = radio.value;
                let hidden = form.querySelector('input[type="hidden"][name="fechaCompare"]');
                if (hidden) hidden.remove();
                actualizarContenido()
               // form.submit();
            }
        });
    });
  

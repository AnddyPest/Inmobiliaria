    function cambiarPagina(nroPagina) {
        pagina = nroPagina;
        actualizarContenido();
    }
    async function actualizarContenido(){
        const inputInmueble = document.getElementById('inputFiltroInmueble').value;
        const disponibilidad = document.querySelector('input[name="disponibilidad"]:checked')?.value || '';
        const fechaCompare = document.querySelector('input[name="fechaCompare"]:checked')?.value || '';

        const filtros = new URLSearchParams();
        filtros.append("inmueble",inputInmueble)
        filtros.append("nroPagina",pagina);
        filtros.append("disponibilidad",disponibilidad);
        filtros.append("fechaCompare",fechaCompare);
        
       
        const response = await fetch( '/Contrato/listar?' + filtros);
        const html = await response.text();
        const dom = new DOMParser().parseFromString(html, 'text/html');
        const fragmentoTabla = obtenerFragmentoHTML('contenedorTabla', dom);
        const fragmentoPaginacion = obtenerFragmentoHTML('contenedorPaginacion', dom);
        document.getElementById('contenedorTabla').replaceWith(fragmentoTabla);
        document.getElementById('contenedorPaginacion').replaceWith(fragmentoPaginacion);
    }
    function obtenerFragmentoHTML(id , html){
        
        return html.getElementById(id);
    }
    document.getElementById('inputFiltroInmueble').addEventListener('keydown', actualizarContenido);
</script>
    
    <div class="table-container" id="contenedorTabla" style="min-height: 400px;">
        <table class="table table-striped table-bordered mt-2 table-dark mb-3" id="contratosTable">
            <thead class="table-dark">
                <tr>
                    <th style="width: 5%;">ID</th>
                    <th style="width: 10%;">Inquilino</th>
                    <th style="width: 10%;">Propietario</th>
                    <th style="width: 10%;">Inmueble</th>
                    <th style="width: 10%;">Fecha Inicio</th>
                    <th style="width: 10%;">Fecha Fin</th>
                    <th style="width: 10%;">Rescisión</th>
                    <th style="width: 10%;">Monto</th>
                    <th style="width: 10%;">Estado</th>
                    <th style="width: 15%;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.contratos != null)
                {
                    foreach (Contrato contrato in Model.contratos)
                    {
                        
                        <tr>
                            <td class="text-center">@contrato.IdContrato</td>
                            <td class="text-center">@contrato.Inquilino?.Nombre @contrato.Inquilino?.Apellido - @contrato.Inquilino.Dni</td>
                            <td class="text-center">@contrato.Propietario?.Nombre @contrato.Propietario?.Apellido - @contrato.Propietario.Dni</td>
                            <td class="text-center">@contrato.inmueble?.Direccion</td>
                            <td class="text-center">@contrato.FechaInicio.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">@contrato.FechaFin.ToString("dd/MM/yyyy")</td>
                            @if (contrato.FechaRescision != null)
                            {
                                <td class="text-center text-danger fw-bold">@contrato.FechaRescision?.ToString("dd/MM/yyyy")</td>
                            }
                            else
                            {
                                <td class="text-center">
                                    @if (contrato.FechaFin.Date < DateTime.Now.Date)
                                    {
                                        <span class="text-danger fw-bold">Vencido</span>
                                    }
                                    else
                                    {
                                        <span class="text-success fw-bold">Activo</span>
                                    }
                                </td>
                            }
                            <td class="text-center">$@contrato.Monto</td>
                            <td class="text-center">
                                @if (contrato.estado)
                                {
                                    <span class="text-success">
                                        <i class="bi bi-check-circle-fill" style="font-size: 1.3em;"></i>
                                    </span>
                                }
                                else
                                {
                                    <span class="text-danger">
                                        <i class="bi bi-x-circle-fill" style="font-size: 1.3em;"></i>
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                <!-- BOTÓN EDITAR CONTRATO -->
                                <a class="btn btn-warning p-1 m-1 w-25" href="#">
                                    <i class="bi bi-pencil-square"></i> <!-- EDITAR CONTRATO -->
                                </a>
                                <!-- BOTÓN DE GENERAR PAGOS -->
                                @if (contrato.FechaRescision != null || !contrato.estado)
                                {
                                    <button class="btn btn-secondary p-1 m-1 w-25" disabled>
                                        <i class="bi bi-cash-stack"></i> <!-- GENERAR PAGOS -->
                                    </button>
                                }
                                else if (contrato.estado && (contrato.FechaRescision == null && contrato.FechaFin.Date < DateTime.Now.Date))
                                {
                                    <a type="button" class="btn btn-primary p-1 m-1 w-25" onclick="abrirModalRenovar(@contrato.IdContrato, @contrato.IdInquilino, @contrato.IdPropietario, @contrato.IdInmueble, @contrato.Monto, '@contrato.FechaFin.ToString(format: "yyyy-MM-dd")')">
                                        <i class="bi bi-file-check"></i> <!-- Renovar Contrato -->
                                    </a>
                                }
                                else if (contrato.estado)
                                {
                                <button type="button" class="btn btn-success p-1 m-1 w-25" data-bs-toggle="modal" data-bs-target="#modalPago_@contrato.IdContrato">
                                    <i class="bi bi-cash-stack"></i> <!-- GENERAR PAGOS -->
                                </button>

                                }
                                <!-- BOTÓN DE IR A PAGOS -->
                                <button class="btn btn-info p-1 m-1 w-25" onclick="location.href='/Pago/Listar/@contrato.IdContrato'">
                                    <i class="bi bi-currency-dollar"></i> <!-- IR A PAGOS -->
                                </button>
                                <!-- MODAL GENERAR PAGO -->
                                <div class="modal fade" id="modalPago_@contrato.IdContrato" tabindex="-1" aria-labelledby="modalPagoLabel_@contrato.IdContrato" aria-hidden="true">
                                    <div class="modal-dialog modal-lg">
                                        <div class="modal-content border-success shadow-lg">
                                            <div class="modal-header bg-success text-white">
                                                <h5 class="modal-title" id="modalPagoLabel_@contrato.IdContrato">
                                                    <i class="bi bi-cash-stack me-2"></i>Generar Pago para Contrato #@contrato.IdContrato
                                                </h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                            </div>
                                            <div class="modal-body bg-light">
                                                <form id="formPago_@contrato.IdContrato" action="/Pago/Create" method="post" autocomplete="off">
                                                    <div class="mb-3">
                                                        <label for="importe_@contrato.IdContrato" class="form-label text-dark ">Importe</label>
                                                        <input type="number" class="form-control" id="importe_@contrato.IdContrato" name="Importe" required value="@(contrato.Monto)">
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="fechaConfeccion_@contrato.IdContrato" class="form-label text-dark">Fecha de Confeccion</label>
                                                        <input type="date" class="form-control" id="fechaConfeccion_@contrato.IdContrato" name="fechaConfeccion" required value="@(DateOnly.FromDateTime(DateTime.Now).ToString("yyyy-MM-dd"))">
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="detallePago_@contrato.IdContrato" class="form-label text-dark">Detalle</label>
                                                        <textarea class="form-control" id="detallePago_@contrato.IdContrato" name="Detalle" rows="2"></textarea>
                                                    </div>
                                                    <input type="hidden" name="IdContrato" value="@contrato.IdContrato" />
                                                    <div class="d-flex justify-content-end">
                                                        <button type="submit" class="btn btn-success">Crear Pago</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
        <div class="col d-flex w-100 justify-content-between" id="contenedorPaginacion">

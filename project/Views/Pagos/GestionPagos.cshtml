@model project.Models.ViewModels.PagoViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Gestión de Pagos";
    var Pagina = ViewBag.nroPagina ?? 1;
;}

<style>
    .modal-lg {
        max-width: 90%;
    }
    * .table-container2 {
        max-height: 400px;
        overflow-y: auto;
    }   
    .table th {
        background-color: #0d6efd;
        color: white;
        position: sticky;
        top: 0;
    }
    .modal-header {
        background-color: #0d6efd;
        color: white;
    }
</style>

<div class="container">
    <div class="d-flex flex-column p-2 border border-success-subtle rounded" style="background-color: #e3daccc8; min-height: 80vh; min-width: 80vw; margin: 0 auto;">
        <div class="row w-100">
            <div class="col w-75">
                <h3 class="text-primary mb-2 ms-3">Listado de Pagos</h3>
            </div>
        </div>
        <div class="table-responsive p-2" style="min-height: 600px;">
            <table class="table table-dark table-stripped" style="overflow-x: auto;">
                <thead>
                    <tr class="text-center">
                        <th style="width: 8%;">N° Pago</th>
                        <th style="width: 12%;">Fecha Confección</th>
                        <th style="width: 12%;">Fecha de Pago</th>
                        <th style="width: 10%;">Importe</th>
                        <th style="width: 34%;">Detalle</th>
                        <th style="width: 5%;">Estado</th>
                        <th style="width: 5%;">Abonado</th>
                        <th style="width: 10%;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Pagos.Count > 0)
                    {
                        foreach (var pago in Model.Pagos)
                        {
                            <tr class="text-center">
                                <td>@pago.IdPago</td>
                                <td>@pago.FechaConfeccion.ToString("dd/MM/yyyy")</td>
                                <td>@(pago.FechaPago != null ? pago.FechaPago.Value.ToString("dd/MM/yyyy") : "-")</td>
                                <td>$@pago.Importe.ToString("F2")</td>
                                <td>@pago.Detalle</td>
                                <td>
                                    @if(pago.Estado){
                                        <i class="badge bi-check-circle-fill fs-5 text-success" title="Activo"/>
                                    }else{
                                        <i class="badge bi-x-circle-fill fs-5 text-danger" title="Anulado" />
                                    }
                                </td>
                                <td>
                                    @if (pago.Abonado && pago.Estado)
                                    {
                                        <i class="badge bi-check-circle-fill fs-5 text-success" />
                                    }
                                    else
                                    {
                                        <i class="badge bi-x-circle-fill fs-5 text-danger" />
                                    }
                                </td>
                                <td>

                                    
                                    @if(pago.Estado){
                                        <button class="btn btn-sm btn-info me-1" title="Actualizar Pago" onclick="modalActualizarDetalle(@pago.IdPago, '@pago.Detalle', @Model.IdContrato)" >
                                            <i class="bi-pencil-square"></i>
                                        </button>
                                        @if(!pago.Abonado)
                                        {
                                            <a class="btn btn-sm btn-primary me-1" title="Asentar Pago" href="@Url.Action("AsentarPago", "Pagos", new { idPago = pago.IdPago })">
                                                <i class="bi-cash-coin"></i>
                                            </a>
                                        } else {
                                            @if(User.IsInRole("Administrador")){
                                                <a class="btn btn-sm btn-warning me-1" title="Anular Pago" href="@Url.Action("AnularPago", "Pagos", new { idPago = pago.IdPago })">
                                                    <i class="bi-arrow-counterclockwise fs-"></i>
                                                </a>
                                            }
                                            
                                        }
                                        @if(User.IsInRole("Administrador")){
                                            <a class="btn btn-sm btn-danger" title="Eliminar Pago" href="@Url.Action("DarDeBaja", "Pagos", new { idPago = pago.IdPago , idContrato = Model.IdContrato})">
                                                <i class="bi-trash"></i>
                                            </a>
                                        }
                                       
                                    }else{
                                        <a class="btn btn-sm btn-primary" title="Dar alta Pago" href="@Url.Action("DarDeAlta", "Pagos", new { idPago = pago.IdPago , idContrato = Model.IdContrato})">
                                            <i class="bi-check"></i>
                                        </a>
                                    }
                                    @if(User.IsInRole("Administrador")){
                                        <button class="btn btn-success w-25" aria-modal="true" data-bs-toggle="modal" data-bs-target="#modalAuditoria" data-id-pago="@pago.IdPago">
                                            <i class="bi bi-search"></i> <!-- AUDITORIA -->
                                        </button>
                                    }
                                </td>
                            </tr>

                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center">No hay pagos registrados para este contrato.</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="modal fade" id="modalActualizarDetalle" tabindex="-1" aria-labelledby="modalRenovarLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content"> 
                    
                        <div class="modal-header">
                            <h5 class="modal-title" id="modalRenovarLabel">Renovar Contrato</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                        </div>   
                        <div class="modal-body">
                            <form action="@Url.Action("ActualizarDetalle","Pagos")" method="post">
                                <input type="hidden" name="idPago" id="idPago"  />
                                <input type="hidden" name="idContrato" id="idContrato"  />
                                <div class="mb-3">
                                    <label for="detalle" class="form-label">Detalle</label>
                                    <input type="text" id="detalle" name="detalle" class="form-control" required />
                                </div>
                                <div class="modal-footer">
                                    <button type="submit" class="btn btn-success">Confirmar Renovación</button>
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                </div>
                            </form>
                        </div> 
                    </div>
                </div>
            </div>
        </div>
        <div class="col d-flex w-100 justify-content-between">
            <nav aria-label="Page navigation">
                <ul class="pagination">
                    @if (Pagina > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("GetPagosByIdContrato", "Pagos", new { idContrato = Model != null ? Model.IdContrato : 0, nroPagina = Pagina - 1 })" aria-label="Anterior">
                                <i class="bi bi-chevron-double-left"></i>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link"><i class="bi bi-chevron-double-left"></i></span>
                        </li>
                    }
                    @{
                        int totalPaginas = (int)Math.Ceiling((double)(ViewBag.totalPagos ?? 0) / (ViewBag.registrosPorPagina ?? 10));
                    }
                    @for (int i = 1; i <= totalPaginas; i++)
                    {
                        <li class="page-item @(i == Pagina ? "active" : "")">
                            <a class="page-link" href="@Url.Action("GetPagosByIdContrato", "Pagos", new { idContrato = Model != null ? Model.IdContrato : 0, nroPagina = i })">@i</a>
                        </li>
                    }
                    @if (Pagina < totalPaginas)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("GetPagosByIdContrato", "Pagos", new { idContrato = Model != null ? Model.IdContrato : 0, nroPagina = Pagina + 1 })" aria-label="Siguiente">
                                <i class="bi bi-chevron-double-right"></i>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link"><i class="bi bi-chevron-double-right"></i></span>
                        </li>
                    }
                </ul>
            </nav>
            <button class="btn btn-danger h-100" onclick="window.location.href='/contrato/listar'">Volver</button>
        </div>
    <div class="modal fade" id="modalAuditoria" tabindex="-1" aria-labelledby="modalAuditoriaLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalAuditoriaLabel">Registros de Auditoría</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="table-container table-container2">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Id Contrato</th>
                                    <th>Id Pago</th>
                                    <th>Nombre</th>
                                    <th>Apellido</th>
                                    <th>DNI</th>
                                    <th>Motivo</th>
                                    <th>Fecha</th>
                                </tr>
                            </thead>
                            <tbody id="tablaAuditoria">
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
<script>
    function modalActualizarDetalle(idPago, detalle, idContrato){
        document.getElementById('idPago').value = idPago;
        document.getElementById('detalle').value = detalle;
        document.getElementById('idContrato').value = idContrato;
        const modal = new bootstrap.Modal(document.getElementById('modalActualizarDetalle'));
        modal.show();
    }
    function actualizarContenidoAuditoria(data){
        let tbody = document.getElementById('tablaAuditoria');
        tbody.innerHTML = ''; // Limpiar tabla
        console.log("linea: 612 - data: ", data.auditorias);
        if (data && data.auditorias.length > 0) {
            console.log("linea: 614 - data: ", data.auditorias);
            data.auditorias.forEach((auditoria) => {
                let tr = document.createElement('tr');
                console.log("linea: 358 - auditoria: ", auditoria);
                tr.innerHTML = `
                    <td>${auditoria.idContrato || ''}</td>
                    <td>${auditoria.idPago || ''}</td>
                    <td>${auditoria.usuario.empleado.nombre || ''}</td>
                    <td>${auditoria.usuario.empleado.apellido || ''}</td>
                    <td>${auditoria.usuario.empleado.dni || ''}</td>
                    <td>${auditoria.motivoAuditoria || ''}</td>
                    <td>${auditoria.fecha ? new Date(auditoria.fecha).toLocaleString() : ''}</td>
                `;
                tbody.appendChild(tr);
            });
        } else {
            tbody.innerHTML = '<tr><td colspan="6" class="text-center">No hay registros de auditoría</td></tr>';
        }
    }
    async function buscarAuditoriaPago(idPago){
        try{
            const response = await fetch(`/auditoria/pagos/${idPago}`);
            if(!response.ok){
                throw new Error('Error al buscar auditoria');
            }
            const data = await response.json();
            actualizarContenidoAuditoria(data);
        }catch(error){
            console.log(error);
            // Mostrar mensaje de error
            document.getElementById('tablaAuditoria').innerHTML = 
                '<tr><td colspan="6" class="text-center text-danger">Error al cargar los datos de auditoría</td></tr>';
        }
    }
    document.getElementById('modalAuditoria').addEventListener('show.bs.modal', function (event) {
        document.getElementById('tablaAuditoria').innerHTML = '';
        
        const button = event.relatedTarget;
        
        const idPago = button.getAttribute('data-id-pago');
        
        if (idPago) {
            buscarAuditoriaPago(idPago);
        }
    });
</script>

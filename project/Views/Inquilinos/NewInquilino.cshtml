<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nuevo Inquilino</title>

    <style>
        .img-shadow {
            box-shadow: 0 10px 28px rgba(0,0,0,0.20);
            border-radius: 0.5rem;
            transition: box-shadow .18s ease, transform .18s ease;
            transform-origin: center;
        }
        .img-shadow:hover {
            box-shadow: 0 18px 40px rgba(0,0,0,0.28);
            transform: scale(0.98);
        }
    </style>
</head>
<body>
    <div class="d-flex flex-column p-2 border border-success-subtle rounded" style="background-color: #e3daccc8; min-height: 80vh; min-width: 80vw; margin: 0 auto;">

        <h3 class="text-primary mb-3">Registrar Nuevo Inquilino</h3>
    <form action="/Inquilino/Create" method="POST" class="p-3 border border-success mb-2 rounded" id="formInquilino">
            <div class="row mb-3">
                <div class="col">
                    <label for="dni">DNI:</label>
                    <input type="text" id="dni" name="dni" class="form-control" required>
                </div>
                <div class="col">
                    <label for="nombre">Nombre:</label>
                    <input type="text" id="nombre" name="nombre" class="form-control" required disabled>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col">
                    <label for="apellido">Apellido:</label>
                    <input type="text" id="apellido" name="apellido" class="form-control" required disabled>
                </div>
                <div class="col">
                    <label for="telefono">Teléfono:</label>
                    <input type="text" id="telefono" name="telefono" class="form-control" required disabled>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col">
                    <label for="direccion">Dirección:</label>
                    <input type="text" id="direccion" name="direccion" class="form-control" required disabled>
                </div>
                <div class="col">
                    <label for="email">Email:</label>
                    <input type="email" id="email" name="email" class="form-control" required disabled>
                </div>
            </div>

            <div class="mb-3 p-3 row border border-dark rounded w-100 ms-1">
                <div class="col w-25">
                    <button class="btn btn-warning shadow ms-1 me-1 w-100" type="reset" onclick="window.location.reload()">Limpiar Formulario</button>
                </div>
                <div class="col w-25"></div>
                <div class="col w-25"></div>
                <div class="col w-25">
                    <button type="submit" class="btn btn-primary shadow ms-1 me-1 w-100">Registrar Inquilino</button>
                </div>
            </div>
        </form>
        <div class="row border-dark mb-2 rounded">
            <div style="height:25vh; display:flex; align-items:center; justify-content:center; overflow:hidden; width:100%;">
                <img src="@Url.Content("~/images/inmobiliaria.png")" alt="Inmobiliaria" class="img-fluid img-shadow me-5" style="max-height:100%; max-width:100%; object-fit:contain; display:block; border: solid rgb(197, 192, 192)" />
                <img src="@Url.Content("~/images/elegant.png")" alt="Inmobiliaria" class="img-fluid img-shadow ms-5 me-5" style="max-height:100%; max-width:100%; object-fit:contain; display:block; border: solid rgb(197, 192, 192)" />
                <img src="@Url.Content("~/images/key.png")" alt="Inmobiliaria" class="img-fluid img-shadow ms-5" style="max-height:100%; max-width:100%; object-fit:contain; display:block; border: solid rgb(197, 192, 192)" />
            </div>
            
        </div>
        <div class="row justify-content-end w-100">
            <button type="button" class="btn btn-danger shadow ms-1 me-1 w-25" onclick="window.location.href='/Inquilino'">Cancelar</button>
        </div>
    </div>

   
</body>
</html>

<script>
    const dniInput = document.getElementById("dni");
    dniInput.addEventListener("input", function() {
    
    document.getElementById('formInquilino').addEventListener('submit', function(e) {
        ['nombre','apellido','telefono','direccion','email'].forEach(id => {
            document.getElementById(id).removeAttribute('disabled');
        });
    });
        const original = this.value;
        const filtered = original.replace(/[^0-9]/g, '');
        if (original !== filtered) {
            // Feedback visual TEXTO EN ROJO Y BORDE EN ROJO "SOLO NÚMEROS"
            const prevPlaceholder = this.placeholder;
            this.value = filtered;
            this.placeholder = "SOLO NÚMEROS";
            this.classList.add("placeholder-error");
            this.style.color = "#dc3545";
            this.style.fontWeight = "bold";
            this.style.borderColor = "#dc3545";
            setTimeout(() => {
                this.classList.remove("placeholder-error");
                this.placeholder = prevPlaceholder;
                this.style.color = "";
                this.style.fontWeight = "";
                this.style.borderColor = "";
            }, 900);
        }
    });


   dniInput.addEventListener("keyup", function() {
        const dni = this.value;
        if (dni.length >= 8) {
            // Consultar ambos endpoints en paralelo (rutas absolutas)
            Promise.all([
                fetch('/Propietario/BuscarPorDni?dni=' + dni).then(r => r.ok ? r.json() : {}),
                fetch('/Inquilino/BuscarPorDni?dni=' + dni).then(r => r.ok ? r.json() : {})
            ]).then(([prop, inq]) => {
                // Completa los campos si la persona existe en propietario o inquilino
                let nombre = prop.nombre || inq.nombre || '';
                let apellido = prop.apellido || inq.apellido || '';
                document.getElementById('nombre').value = nombre;
                document.getElementById('apellido').value = apellido;
                document.getElementById('telefono').value = prop.telefono || inq.telefono || '';
                document.getElementById('direccion').value = prop.direccion || inq.direccion || '';
                document.getElementById('email').value = prop.email || inq.email || '';

                let mensajes = [];
                if (inq.esInquilino) {
                    mensajes.push(`El cliente ${nombre} ${apellido} figura como inquilino en nuestra base de datos, no puede guardarse nuevamente.`);
                }
                if (prop.esPropietario) {
                    mensajes.push(`${nombre} ${apellido} figura como propietario de uno o más inmuebles.`);
                }
                if (mensajes.length > 0) {
                    showPersonaModal(mensajes.join('\n'));
                    if(inq.esInquilino) {
                        document.querySelector('button[type="submit"]').disabled = true;
                    }
                } else {
                    hidePersonaModal();
                    document.querySelector('button[type="submit"]').disabled = false;
                    // Habilitar campos para alta manual
                    ['nombre','apellido','telefono','direccion','email'].forEach(id => {
                        document.getElementById(id).removeAttribute('disabled');
                    });
                }
            }).catch(() => {
                // Si no existe, limpia y habilita los campos
                document.getElementById('nombre').value = '';
                document.getElementById('apellido').value = '';
                document.getElementById('telefono').value = '';
                document.getElementById('direccion').value = '';
                document.getElementById('email').value = '';
                ['nombre','apellido','telefono','direccion','email'].forEach(id => {
                    document.getElementById(id).removeAttribute('disabled');
                });
                hidePersonaModal();
                document.querySelector('button[type="submit"]').disabled = false;
            });
        } else {
            // Si la longitud es menor a 8, limpia y deshabilita los campos
            document.getElementById('nombre').value = '';
            document.getElementById('apellido').value = '';
            document.getElementById('telefono').value = '';
            document.getElementById('direccion').value = '';
            document.getElementById('email').value = '';
            ['nombre','apellido','telefono','direccion','email'].forEach(id => {
                document.getElementById(id).setAttribute('disabled', 'disabled');
            });
            hidePersonaModal();
        }
    });

    
    function showPersonaModal(msg) {
        let modal = document.getElementById('jsPersonaModal');
        if (!modal) {
            modal = document.createElement('div');
            modal.id = 'jsPersonaModal';
            modal.style.position = 'fixed';
            modal.style.top = '0';
            modal.style.left = '0';
            modal.style.width = '100vw';
            modal.style.height = '100vh';
            modal.style.background = 'rgba(0,0,0,0.4)';
            modal.style.display = 'flex';
            modal.style.alignItems = 'center';
            modal.style.justifyContent = 'center';
            modal.style.zIndex = '9999';
            modal.innerHTML = `
                <div id="jsPersonaModalContent" style="background: #fff; padding: 2rem 2.5rem; border-radius: 1rem; box-shadow: 0 0 30px #0005; text-align: center; min-width: 320px; max-width: 90vw;">
                    <h4 style="color: #b85c00; margin-bottom: 1.5rem;">Atención</h4>
                    <div id="jsPersonaModalMsg" style="font-size: 1.15rem; margin-bottom: 1.5rem; white-space: pre-line;">${msg}</div>
                    <button id="jsPersonaModalClose" class="btn btn-secondary">Cerrar</button>
                </div>
            `;
            document.body.appendChild(modal);
            document.getElementById('jsPersonaModalClose').onclick = function() {
                document.getElementById('jsPersonaModal').remove();
            };
        } else {
            
            let msgDiv = document.getElementById('jsPersonaModalMsg');
            if (msgDiv) {
                msgDiv.innerText = msg;
            }
            let closeBtn = document.getElementById('jsPersonaModalClose');
            if (!closeBtn) {
                let contentDiv = document.getElementById('jsPersonaModalContent');
                if (contentDiv) {
                    let btn = document.createElement('button');
                    btn.id = 'jsPersonaModalClose';
                    btn.className = 'btn btn-secondary';
                    btn.innerText = 'Cerrar';
                    btn.onclick = function() {
                        document.getElementById('jsPersonaModal').remove();
                    };
                    contentDiv.appendChild(btn);
                }
            }
            modal.style.display = 'flex';
        }
    }
    function hidePersonaModal() {
        let modal = document.getElementById('jsPersonaModal');
        if (modal) modal.remove();
    }
</script>
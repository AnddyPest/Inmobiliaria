@{
    ViewData["Title"] = "Inmobi-Tec";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .bienvenida-divertida {
        background: #fff8f0;
        border-radius: 18px;
        box-shadow: 0 2px 12px 0 #b6a88a33;
        padding: 2rem 1.5rem 1.5rem 1.5rem;
        max-width: 600px;
        text-align: center;
        border: 2px solid #e0d3c2;
    }

    .bienvenida-titulo {
        font-size: 1.5rem;
        font-weight: bold;
        color: #7c5c3e;
        letter-spacing: 1px;
    }

    .bienvenida-texto {
        color: #5a4633;
        font-size: 1.08rem;
        display: block;
        margin-bottom: 0.2em;
    }

    .bienvenida-remate {
        color: #b07d2c;
        font-size: 1.1rem;
        font-weight: 500;
        margin-top: 0.5em;
        display: block;
    }

    .emoji-casa {
        font-size: 2.2rem;
        vertical-align: middle;
        margin-bottom: 0.2em;
        display: block;
    }

    .img-shadow {
        box-shadow: 0 10px 28px rgba(0,0,0,0.20);
        border-radius: 0.5rem;
        transition: box-shadow .18s ease, transform .18s ease;
        transform-origin: center;
    }

        .img-shadow:hover {
            box-shadow: 0 18px 40px rgba(0,0,0,0.28);
            transform: scale(0.98);
        }

    .card {
        transition: transform 0.3s ease;
    }

    .card:hover {
        transform: translateY(-5px);
    }
</style>
<div class="container-fluid" style=" min-height: 100vh; padding: 2rem;">
    <div class="text-center mb-5">
        <h1 class="display-4 text-white fw-bold shadow" style="border-bottom:dotted">Sistema de Gestión Inmobiliario</h1>
    </div>

    <!-- Mensaje de bienvenida -->
    <div class="bienvenida-divertida mx-auto mb-5">
        <p>
            <span class="emoji-casa">🏠</span>
            <span class="bienvenida-titulo">¡Bienvenido a Inmobi-Tec!</span><br>
            <span class="bienvenida-texto">¿Listo para convertirte en gestor inmobiliario?</span><br>
            <span class="bienvenida-texto">Acá podés domar inquilinos, domar propietarios y firmar contratos como un verdadero profesional.</span><br>
            <span class="bienvenida-remate">¡Gestioná todo con un par de clics y sentite el <b>Messi</b> de los alquileres!</span>
        </p>
    </div>

    <!-- Sección de módulos -->
    <div class="row justify-content-center g-4">
        <div class="col-lg-3 col-md-6 col-sm-12">
            <div class="card h-100 border-0 shadow-sm" style="background-color: #f8f9fa;">
                <div class="card-body text-center">
                    <h5 class="card-title text-primary mb-3">Gestión de Inquilinos</h5>
                    <img src="@Url.Content("~/images/Inquilinos.png")"
                         alt="Nuevo Inquilino"
                         class="img-fluid img-shadow rounded"
                         style="max-width: 100%; object-fit: contain; cursor: pointer;"
                         onclick="window.location.href='/Inquilino'" />
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 col-sm-12">
            <div class="card h-100 border-0 shadow-sm" style="background-color: #f8f9fa;">
                <div class="card-body text-center">
                    <h5 class="card-title text-primary mb-3">Gestión de Propietarios</h5>
                    <img src="@Url.Content("~/images/Propietarios.png")"
                         alt="Nuevo Propietario"
                         class="img-fluid img-shadow rounded"
                         style="max-width: 100%; object-fit: contain; cursor: pointer;"
                         onclick="window.location.href='/Propietario'" />
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 col-sm-12">
            <div class="card h-100 border-0 shadow-sm" style="background-color: #f8f9fa;">
                <div class="card-body text-center">
                    <h5 class="card-title text-primary mb-3">Gestión de Inmuebles</h5>
                    <img src="@Url.Content("~/images/GInmueble.png")"
                         alt="Nuevo Inmueble"
                         class="img-fluid img-shadow rounded"
                         style="max-width: 100%; object-fit: contain; cursor: pointer;"
                         onclick="window.location.href='/Inmueble'" />
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 col-sm-12">
            <div class="card h-100 border-0 shadow-sm" style="background-color: #f8f9fa;">
                <div class="card-body text-center">
                    <h5 class="card-title text-primary mb-3">Gestión de Contratos</h5>
                    <img src="@Url.Content("~/images/LogoContratos.png")"
                         alt="Nuevo Contrato"
                         class="img-fluid img-shadow rounded"
                         style="max-width: 100%; object-fit: contain; cursor: pointer;"
                         onclick="window.location.href='/Contrato'" />
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 col-sm-12">
            <div class="card h-100 border-0 shadow-sm" style="background-color: #f8f9fa;">
                <div class="card-body text-center">
                    <h5 class="card-title text-primary mb-3">Gestión de Empleados</h5>
                    <img src="@Url.Content("~/images/empleados.png")"
                         alt="Gestionar Empleados"
                         class="img-fluid img-shadow rounded"
                         style="max-width: 100%; object-fit: contain; cursor: pointer;"
                         onclick="window.location.href='/Empleado'" />
                </div>
            </div>
        </div>
    </div>
</div>



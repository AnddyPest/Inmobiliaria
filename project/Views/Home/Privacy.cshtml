@{
    ViewData["Title"] = "Gestion de base de datos";
}
<style>
    .card {
        transition: transform 0.3s ease;
    }

    .card:hover {
        transform: translateY(-5px);
    }
</style>
<div class="container-fluid mt-5" style="min-height:100vh;">
    <div class="row p-0 mb-5" >
        <h1 class="text-center text-white border-2 shadow fs-1 p-4" >@ViewData["Title"]</h1>
    </div>
    <div class="row ">
        <div class="col-lg-3 col-md-6 col-sm-12 p-1">
            <div class="card h-100 border-0 shadow-sm" style="background-color: #f8f9fa;">
                <div class="card-body text-center m-2">
                    <h5 class="card-title text-primary mb-3 fs-4 ">Gestión de Tipos de Inmueble</h5>
                    <img src="@Url.Content("~/images/TiposDeInmueble.png")"
                         alt="Tipos de Inmueble"
                         class="img-fluid img-shadow rounded"
                         style="max-width: 100%; object-fit: contain; cursor: pointer;"
                         onclick="window.location.href='@Url.Action("ListarTiposDeInmueble","Tipo_Inmueble")'" />
                </div>
            </div>
        </div>
    </div>
</div>
